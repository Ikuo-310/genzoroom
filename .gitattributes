# Publishing scripts must remain executable by Bash after Windows checkouts.
release/*.sh text eol=lf
# Icon source hashes and generated SVG comparisons are byte-exact across platforms.
design/genzo_icon_fix.svg text eol=lf
desktop/icons/export-badge.svg text eol=lf
# Patch digests must survive Windows checkouts byte-for-byte.
# Unified diff blank context lines contain a required space prefix.
native/lightcraft/patches/*.patch text eol=lf whitespace=-blank-at-eol
