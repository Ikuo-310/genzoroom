# Optional Web UI host port. Copy this file to .env to override the default.
GENZOROOM_PORT=3190

# Distribution only: copy an already published tag from the workflow summary.
# No default or unpublished v0.1.0 tag is selected automatically.
# GENZOROOM_IMAGE_TAG=sha-<full-commit-sha>-run<run-id>-attempt<attempt-number>

# Host storage parent mounted at /genzoroom. Create this parent before deploying.
# Grant UID/GID 10001:10001 write access; Backend creates data/ if needed.
GENZOROOM_PERSIST_ROOT=/path/to/genzoroom

# Example Immich connection. Replace these through local or Portainer settings.
# Never commit a real API key.
IMMICH_URL=http://immich-server:2283
IMMICH_API_KEY=replace-with-your-api-key

# Optional: used with the development/release Immich network override,
# or compose.release.immich-standalone.yml for Portainer Web editor.
# IMMICH_DOCKER_NETWORK=your-immich-docker-network
