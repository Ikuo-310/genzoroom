# Optional Web UI host port. Copy this file to .env to override the default.
GENZOROOM_PORT=3190

# Host directory for persistent GenzoRoom data. Create its data subdirectory before deploying.
GENZOROOM_PERSIST_ROOT=/share/Container/genzoroom
# Optional: place data on separate host storage instead of PERSIST_ROOT/data.
# GENZOROOM_DATA_PATH=/another/path/genzoroom-data

# Example Immich connection. Replace these through local or Portainer settings.
# Never commit a real API key.
IMMICH_URL=http://immich-server:2283
IMMICH_API_KEY=replace-with-your-api-key

# Optional: only used with docker-compose.immich-network.yml.
# IMMICH_DOCKER_NETWORK=your-immich-docker-network
