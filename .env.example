# Copy this file to .env and adjust values for your environment.
GENZOROOM_IMAGE_TAG=latest
GENZOROOM_PORT=3190

# Host storage parent mounted at /genzoroom. Create this parent before deploying.
# Grant UID/GID 10001:10001 write access; Backend creates data/ if needed.
GENZOROOM_PERSIST_ROOT=/path/to/genzoroom

# Example Immich connection. Replace these values for your environment.
# Never commit a real API key.
IMMICH_URL=http://immich-server:2283
IMMICH_API_KEY=replace-with-your-api-key

# Optional: set this when combining compose.release.yml with
# compose.release.immich-network.yml to join an existing external network.
# IMMICH_DOCKER_NETWORK=your-immich-docker-network
