diff --git a/crates/mcp/src/tests.rs b/crates/mcp/src/tests.rs
index 1788512..c9c1122 100644
--- a/crates/mcp/src/tests.rs
+++ b/crates/mcp/src/tests.rs
@@ -44,0 +45,71 @@ fn headless_photo_retirement_keeps_other_photo_and_drops_history_references() {
+#[test]
+fn headless_import_replaces_only_released_least_recent_photo() {
+    let base = std::env::temp_dir().join(format!("lc-mcp-resident-p2-3-{}", std::process::id()));
+    let _ = std::fs::remove_dir_all(&base);
+    std::fs::create_dir_all(&base).unwrap();
+    for (index, name) in ["A", "B", "C", "D", "E", "F"].into_iter().enumerate() {
+        let image = lightcraft_raster::Rgba8 { width: 12, height: 8, data: vec![[80 + index as u8, 120, 160, 255]; 96] };
+        let png = lightcraft_codecs::encode_png(&lightcraft_codecs::EncodeImage::rgba8(&image), &lightcraft_codecs::EncodeMeta::default()).unwrap();
+        std::fs::write(base.join(format!("{name}.png")), png).unwrap();
+    }
+    let mut headless = Headless::new(lightcraft_engine::Session::new().with_fs());
+    let import = |headless: &mut Headless, name: &str| {
+        headless.call("headless.importWithEviction", json!({"paths": [base.join(format!("{name}.png")).to_string_lossy()]})).unwrap()
+    };
+    let a = import(&mut headless, "A")["importedIds"][0].as_u64().unwrap();
+    let b = import(&mut headless, "B")["importedIds"][0].as_u64().unwrap();
+    let duplicate = import(&mut headless, "A");
+    assert_eq!(duplicate["status"], "ok");
+    assert!(duplicate["retiredIds"].as_array().unwrap().is_empty(), "a resident reimport request must not evict another photo");
+    assert_eq!(headless.session.catalog.photos().count(), 2);
+
+    for id in [a, b, a] {
+        headless.call("engine.execute", json!({"command": "library.select", "params": {"ids": [id], "active": id}})).unwrap();
+    }
+    assert!(headless.call("headless.releasePhoto", json!({"id": a})).unwrap_err().contains("selected"));
+    headless.call("headless.releasePhoto", json!({"id": b})).unwrap();
+    let c_result = import(&mut headless, "C");
+    assert_eq!(c_result["status"], "ok");
+    assert_eq!(c_result["retiredIds"], json!([b]));
+    let c = c_result["importedIds"][0].as_u64().unwrap();
+    assert!(headless.session.catalog.photo(lightcraft_engine::catalog::PhotoId(a)).is_some(), "the recently selected photo remains resident");
+    assert!(headless.session.catalog.photo(lightcraft_engine::catalog::PhotoId(b)).is_none());
+
+    headless.call("engine.execute", json!({"command": "library.select", "params": {"ids": [c], "active": c}})).unwrap();
+    headless.call("headless.releasePhoto", json!({"id": a})).unwrap();
+    let d_result = import(&mut headless, "D");
+    assert_eq!(d_result["retiredIds"], json!([a]));
+    let d = d_result["importedIds"][0].as_u64().unwrap();
+    assert!(headless.session.catalog.photo(lightcraft_engine::catalog::PhotoId(a)).is_none());
+
+    headless.call("engine.execute", json!({"command": "library.select", "params": {"ids": [d], "active": d}})).unwrap();
+    headless.call("headless.releasePhoto", json!({"id": c})).unwrap();
+    let e_result = import(&mut headless, "E");
+    assert_eq!(e_result["retiredIds"], json!([c]));
+    let e = e_result["importedIds"][0].as_u64().unwrap();
+    headless.call("engine.execute", json!({"command": "library.select", "params": {"ids": [e], "active": e}})).unwrap();
+    headless.call("headless.releasePhoto", json!({"id": d})).unwrap();
+    let a_again = import(&mut headless, "A");
+    assert_eq!(a_again["retiredIds"], json!([d]));
+    let a_again = a_again["importedIds"][0].as_u64().unwrap();
+    assert_ne!(a_again, a, "a reimported photo receives a fresh id");
+    assert_eq!(headless.session.catalog.photos().count(), 2);
+    let no_candidate = import(&mut headless, "F");
+    assert_eq!(no_candidate["status"], "rejected");
+    assert!(no_candidate["retiredIds"].as_array().unwrap().is_empty());
+    assert_eq!(headless.session.catalog.photos().count(), 2);
+    let _ = std::fs::remove_dir_all(&base);
+}
+
+#[test]
+fn headless_resident_replacement_refuses_persistent_libraries() {
+    let dir = std::env::temp_dir().join(format!("lc-mcp-resident-persistent-{}", std::process::id()));
+    let _ = std::fs::remove_dir_all(&dir);
+    let mut headless = Headless::new(lightcraft_engine::Session::new());
+    headless.session.open_library(&dir, false).unwrap();
+    assert!(headless.call("headless.releasePhoto", json!({"id": 1})).unwrap_err().contains("transient"));
+    assert!(headless.call("headless.importWithEviction", json!({})).unwrap_err().contains("transient"));
+    headless.session.close_library().unwrap();
+    let _ = std::fs::remove_dir_all(dir);
+}
+
