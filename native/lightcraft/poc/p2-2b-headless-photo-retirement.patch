+    /// Permanently forget one inactive photo in a disposable, non-persistent session.
+    pub fn retire_headless_photo(&mut self, id: PhotoId) -> Result<()> {
+        if self.library.is_some() {
+            return Err(EngineError::Other("photo retirement requires a transient session".into()));
+        }
+        if self.catalog.photo(id).is_none() {
+            return Err(EngineError::Other(format!("no such photo {}", id.0)));
+        }
+        if self.active() == Some(id) || self.selection.ids.contains(&id) {
+            return Err(EngineError::Other("cannot retire a selected photo".into()));
+        }
+        if self.interaction.is_some() {
+            return Err(EngineError::Other("cannot retire during an interaction".into()));
+        }
+        let op = self.catalog.delete_photos_permanently_ops(&[id]);
+        self.apply_through(op, Catalog::apply)?;
+        self.undo.clear();
+        self.redo.clear();
+        self.pending_log.clear();
+        self.journal.clear();
+        self.before.remove(&id);
+        self.selection.ids.retain(|photo| *photo != id);
+        self.selection.active = self.selection.active.filter(|photo| *photo != id);
+        self.previous_active = self.previous_active.filter(|photo| *photo != id);
+        Ok(())
+    }
+
     pub fn develop_of(&self, id: PhotoId) -> Option<Arc<DevelopSettings>> {
         self.catalog.photo(id).map(|p| p.develop.clone())
     }
