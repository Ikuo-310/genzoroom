diff --git a/crates/mcp/src/tests.rs b/crates/mcp/src/tests.rs
--- a/crates/mcp/src/tests.rs
+++ b/crates/mcp/src/tests.rs
@@ -11,6 +11,35 @@
 
 fn server() -> Server {
     Server::new(Box::new(Headless::demo()))
+}
+
+#[test]
+fn headless_photo_retirement_keeps_other_photo_and_drops_history_references() {
+    let mut headless = Headless::demo();
+    let ids: Vec<_> = headless.session.catalog.photos().map(|photo| photo.id).take(2).collect();
+    let retired = ids[0];
+    let kept = ids[1];
+    assert!(headless.session.retire_headless_photo(lightcraft_engine::catalog::PhotoId(u64::MAX)).is_err());
+    headless.session.execute("library.select", &json!({"ids": [retired.0], "active": retired.0})).unwrap();
+    assert!(headless.session.retire_headless_photo(retired).is_err(), "the active photo is refused");
+    assert!(headless.session.catalog.photo(retired).is_some());
+    headless.session.execute("library.select", &json!({"ids": [kept.0], "active": kept.0})).unwrap();
+    let kept_photo = headless.session.catalog.photo(kept).unwrap().clone();
+    headless.session.before.insert(kept, kept_photo.develop.clone());
+    headless.session.before.insert(retired, kept_photo.develop.clone());
+
+    headless.session.retire_headless_photo(retired).unwrap();
+
+    assert!(headless.session.catalog.photo(retired).is_none());
+    assert_eq!(headless.session.catalog.photo(kept).unwrap().develop, kept_photo.develop);
+    assert_eq!(headless.session.catalog.photo(kept).unwrap().history, kept_photo.history);
+    assert!(headless.session.before.contains_key(&kept));
+    assert!(!headless.session.before.contains_key(&retired));
+    assert!(headless.session.undo.is_empty());
+    assert!(headless.session.redo.is_empty());
+    assert!(headless.session.journal.is_empty());
+    assert!(headless.session.drain_log().is_empty());
+    assert!(headless.session.retire_headless_photo(retired).is_err());
 }
 
