+#[test]
+fn genzoroom_stage_bytes_include_chroma_and_unique_pinned_sources() {
+    use std::sync::Arc;
+    let src = Arc::new(Rgb32f::from_fn(32, 24, |_, _| [0.1; 3]));
+    let cache = crate::StageCache::default();
+    let s = DevelopSettings::default();
+    let info = SourceInfo::default();
+    let _ = crate::render_cached(&src, &info, &s, &RenderRequest::fit(32, 32), &cache);
+    let base = cache.bytes();
+    let chroma = Arc::new(Rgb32f::from_fn(32, 24, |_, _| [0.2; 3]));
+    cache.lock()[0].planes.chroma = Some((0, chroma.clone()));
+    assert_eq!(cache.bytes(), base + chroma.data.len() * 12);
+    let _ = crate::render_cached(&src, &info, &s, &RenderRequest::fit(16, 16), &cache);
+    assert_eq!(cache.len(), 2);
+    assert_eq!(cache.retained_bytes(), cache.bytes() + src.data.len() * 12);
+    cache.clear();
+    assert_eq!(cache.retained_bytes(), 0);
+}
