+        // Lowering the configured limit clears both sides before any new cache admission.
+        let (none, applied) = pool.prepare(0, "geometry-one", Some(1), 32, (32, 32), None);
+        assert!(none.is_none() && !applied);
+        assert_eq!(pool.finish(0, Some(1), false)["retainedBytes"], 0);
+        let _ = pool.prepare(0, "geometry-one", Some(limit), 32, (32, 32), None);
