+#[test]
+fn source_levels_auto_upright_and_work_budget_are_checked() {
+    let mut settings = DevelopSettings::default();
+    settings.geometry.upright = serde_json::from_value(json!("auto")).unwrap();
+    let mut h = host_size(settings, 4000, 3000);
+    let q = target(&mut h, false);
+    let old = h.session.develop_of(PhotoId(1)).unwrap().hash64();
+    for (edge, level) in [(512, "Thumb"), (1536, "Preview"), (2600, "Full"), (4064, "Full")] {
+        let mut query = q.clone();
+        query["desiredLongEdge"] = json!(edge);
+        let r = call(&mut h, &tool_args("plan", query));
+        assert!(!r.is_error, "{:?}", r);
+        let m = r.structured.unwrap();
+        assert_eq!(m["diagnostics"]["sourceLevel"], level);
+        println!(
+            "region preflight edge={edge} level={level} F={}x{} sourceBytes={}",
+            m["response"]["fullWidth"], m["response"]["fullHeight"], m["diagnostics"]["sourceHostBytes"]
+        );
+        assert_eq!(h.session.develop_of(PhotoId(1)).unwrap().hash64(), old);
+    }
+    // A rounded preview with different aspect/auto analysis must never reuse the old geometry id.
+    h.session.media.insert(PhotoId(1), SourceLevel::Preview, Arc::new(Rgb32f::from_fn(2560, 1921, |_, _| [0.3; 3])));
+    let mut changed = q.clone();
+    changed["desiredLongEdge"] = json!(1536);
+    let r = call(&mut h, &tool_args("plan", changed));
+    assert!(r.is_error);
+    assert!(r.content[0]["text"].as_str().unwrap().contains("region_geometry_id_mismatch"));
+    drop(h);
+    let mut s = DevelopSettings::default();
+    s.spots = serde_json::from_value(json!([{"points":[{"x":0.1,"y":0.5}],"size":0.01,"source_offset":{"x":0.85,"y":0.0}}])).unwrap();
+    let mut h = host_size(s, 2560, 1920);
+    let q = target(&mut h, false);
+    let t = render_target(&q, 2560, 1920, PixelWindow { x: 128, y: 800, w: 256, h: 256 }, 16);
+    let r = call(&mut h, &tool_args("render", t));
+    assert!(r.is_error);
+    assert!(r.content[0]["text"].as_str().unwrap().contains("region_work_budget_exceeded"));
+}
