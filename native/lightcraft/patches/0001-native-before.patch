+#[test]
+fn strict_schema_plan_and_settings_are_immutable() {
+    assert!(!validate(&json!(1), &json!({"type":"integer","unknownConstraint":true})));
+    let mut h = host(DevelopSettings::default());
+    let q = target(&mut h, false);
