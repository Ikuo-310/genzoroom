+#[test]
+fn cold_raw_preflight_does_not_suppress_regular_wb_discovery() {
+    use lightcraft_engine::media::DecodedSource;
+    let mut session = Session::new();
+    let mut photo = Photo::new(PhotoId(1), Source::File { path: "cold-fixture.DNG".into() }, "cold", "DNG", 640, 480, "");
+    photo.kind = lightcraft_engine::catalog::MediaKind::Raw;
+    session.catalog.apply(Op::AddPhoto { photo: Box::new(photo) }).unwrap();
+    let job = session.render_job(PhotoId(1), 640, 480, false, true).unwrap();
+    let info = pipeline::SourceInfo { raw: true, relative_wb: false, as_shot_temp: 5500.0, as_shot_tint: 7.0, ..Default::default() };
+    let decoded = DecodedSource::new(Arc::new(Rgb32f::from_fn(640, 480, |_, _| [0.2; 3])), Some(info));
+    let before = session.develop_of(PhotoId(1)).unwrap().hash64();
+    session.accept_preview_source(&job, decoded.clone());
+    assert_eq!(session.develop_of(PhotoId(1)).unwrap().hash64(), before);
+    assert!(!session.media.has_source(PhotoId(1), job.level));
+    let mut regular = job.clone();
+    regular.source = SourceRef::Loaded(Box::new(decoded.clone()));
+    let mut result = regular.run();
+    result.loaded = Some(decoded);
+    session.accept(&result);
+    assert_eq!(session.catalog.photo(PhotoId(1)).unwrap().as_shot_wb, Some((5500.0, 7.0)));
+    assert!(session.media.has_source(PhotoId(1), job.level));
+}
