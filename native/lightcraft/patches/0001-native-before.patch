+    fn genzoroom_cpu_1024_fits_512mib_and_full_pixels_remain_exact() {
+        let src = Arc::new(Rgb32f::from_fn(1280, 963, |x, y| [x as f32 / 1280.0, y as f32 / 963.0, 0.2]));
+        let req = RenderRequest::fit(1024, 1024);
+        let mut pool = StagePool::default();
+        let budget = 512 << 20;
