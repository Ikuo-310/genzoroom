+    #[test]
+    fn genzoroom_rejects_malformed_options_before_rendering() {
+        for value in [Value::Null, json!(true), json!(1), json!("DRAFT"), json!("fast")] {
+            assert!(matches!(Options::parse(&json!({"quality":value})), Err("preview_invalid_quality")));
+        }
+        for value in [Value::Null, json!(true), json!(1.0), json!(2), json!(-1)] {
+            assert!(matches!(Options::parse(&json!({"preview_contract":value})), Err("preview_invalid_contract")));
+        }
+        for value in [Value::Null, json!(true), json!(0), json!("reuse")] {
+            assert!(matches!(Options::parse(&json!({"stage_cache":value})), Err("preview_invalid_stage_cache")));
+        }
+        for value in [Value::Null, json!(true), json!(0), json!(-1), json!(1.0), json!(u64::MAX)] {
+            assert!(matches!(Options::parse(&json!({"stage_cache":"on","stage_cache_budget_bytes":value})), Err("preview_invalid_stage_cache")));
+        }
+        assert!(Options::parse(&json!({"stage_cache":"on"})).is_err());
+        assert!(Options::parse(&json!({"stage_cache":"off","stage_cache_budget_bytes":1})).is_err());
+        assert!(!Options::parse(&json!({})).unwrap().adaptive);
+        let full = Options::parse(&json!({"preview_contract":1})).unwrap();
+        assert!(full.adaptive && !full.draft && full.budget.is_none());
+        assert!(!error("upstream path or secrets").content[0]["text"].as_str().unwrap().contains("upstream"));
+    }
