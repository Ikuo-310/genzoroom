+    assert_eq!(tools.iter().find(|t| t["name"] == "render_region_preview").unwrap()["annotations"]["readOnlyHint"], true);
+    let before = h.session.develop_of(PhotoId(1)).unwrap().hash64();
+    let r = call(&mut h, &tool_args("plan", q.clone()));
+    assert!(!r.is_error);
+    let meta = r.structured.unwrap();
+    assert_eq!(meta["response"]["nativeWidth"], 512);
+    assert_eq!(meta["response"]["fullWidth"], 512);
+    assert_eq!(h.session.develop_of(PhotoId(1)).unwrap().hash64(), before);
+    let mut up = q.clone();
+    up["desiredLongEdge"] = json!(65536);
+    let rr = call(&mut h, &tool_args("plan", up));
+    assert!(!rr.is_error);
+    assert_eq!(rr.structured.unwrap()["response"]["fullWidth"], 512);
+    let mut overscan = DevelopSettings::default();
+    overscan.crop.geometry.rect = serde_json::from_value(json!({"x0":-0.1,"y0":-0.1,"x1":1.1,"y1":1.1})).unwrap();
+    let mut expanded = host(overscan);
+    let mut query = target(&mut expanded, false);
+    query["desiredLongEdge"] = json!(614);
+    let result = call(&mut expanded, &tool_args("plan", query));
+    assert!(!result.is_error, "{:?}", result.content);
+    let response = result.structured.unwrap()["response"].clone();
+    assert!(n(&response, "fullWidth") > 512);
+    assert!(n(&response, "fullWidth") <= n(&response, "nativeWidth"));
+    assert!(n(&response, "fullHeight") <= n(&response, "nativeHeight"));
+    for patch in [json!({"region_contract":2}), json!({"operation":"unknown"}), json!({"extra":true}), json!({"id":1}), json!({"stage_cache":"bad"})]
+    {
+        let mut a = tool_args("plan", q.clone());
+        a.as_object_mut().unwrap().extend(patch.as_object().unwrap().clone());
+        assert!(call(&mut h, &a).is_error);
+    }
+    let mut bad = q.clone();
+    bad["extra"] = json!(true);
+    assert!(call(&mut h, &tool_args("plan", bad)).is_error);
+    assert!(call(&mut h, &tool_args("render", q)).is_error);
+}
+#[test]
+fn c1_cpu_gpu_pixels_and_geometry_matrix() {
+    for gpu in [false, true] {
+        lightcraft_engine::gpu::set_enabled(gpu);
+        if gpu && !lightcraft_engine::gpu::available() {
+            lightcraft_testkit::skip!(Gpu, "Region real device pixel comparisons require an adapter");
+            continue;
+        }
+        for case in [
+            "plain",
+            "exposure",
+            "crop",
+            "rotate90",
+            "rotate180",
+            "rotate270",
+            "flip",
+            "straighten",
+            "nr",
+            "dehaze",
+            "perspective",
+            "local",
+            "rawInfo",
+        ] {
+            let mut s = DevelopSettings::default();
+            match case {
+                "exposure" => s.light.exposure = 0.7,
+                "crop" => s.crop.geometry.rect = serde_json::from_value(json!({"x0":0.1,"y0":0.1,"x1":0.9,"y1":0.9})).unwrap(),
+                "rotate90" => s.orientation = serde_json::from_value(json!("Rotate90")).unwrap(),
+                "rotate180" => s.orientation = serde_json::from_value(json!("Rotate180")).unwrap(),
+                "rotate270" => s.orientation = serde_json::from_value(json!("Rotate270")).unwrap(),
+                "flip" => s.crop.flip_h = true,
+                "straighten" => s.crop.geometry.angle = 7.0,
+                "nr" => {
+                    s.detail.nr_luminance = 40.0;
+                    s.detail.nr_color = 25.0;
+                }
+                "dehaze" => s.effects.dehaze = 30.0,
+                "perspective" => {
+                    s.geometry.vertical = 15.0;
+                    s.optics.distortion = 0.1;
+                }
+                _ => {}
+            }
+            if case == "rawInfo" {
+                s = DevelopSettings::for_raw(5500.0, 7.0);
+            }
+            if case == "local" {
+                let mut mask = lightcraft_engine::develop::Mask::default();
+                mask.adjust.exposure = 0.6;
+                mask.components =
+                    serde_json::from_value(json!([{"shape":{"kind":"linear","start":{"x":0.1,"y":0.2},"end":{"x":0.8,"y":0.9}}}])).unwrap();
+                s.masks.push(mask);
+            }
+            let mut h = host_kind(s, 512, 384, case == "rawInfo");
+            let q = target(&mut h, false);
+            let hash = h.session.develop_of(PhotoId(1)).unwrap().hash64();
+            let plan = call(&mut h, &tool_args("plan", q.clone())).structured.unwrap()["response"].clone();
+            let (fw, fh) = (n(&plan, "fullWidth"), n(&plan, "fullHeight"));
+            let whole = h.session.render_job(PhotoId(1), fw, fh, false, true).unwrap().run().rendered.unwrap().image;
+            let proxy_whole = if case == "dehaze" {
+                Some(h.session.region_job(PhotoId(1), fw, fh, PixelWindow { x: 0, y: 0, w: fw, h: fh }, true).unwrap().run().rendered.unwrap().image)
+            } else {
+                None
+            };
+            if let Some(proxy) = &proxy_whole {
+                let max = whole.data.iter().zip(&proxy.data).flat_map(|(a, b)| (0..3).map(move |c| a[c].abs_diff(b[c]))).max().unwrap();
+                println!("region dehaze wholeProxy gpu={gpu} max={max}");
+            }
+            for context in if ["nr", "dehaze"].contains(&case) { vec![24, 64] } else { vec![24] } {
+                let (ww, hh) = if context == 64 { (256, 256) } else { (160, 128) };
+                for (x, y) in [(fw / 2 - ww / 2, fh / 2 - hh / 2), (0, 0), (fw - ww, 0), (0, fh - hh), (fw - ww, fh - hh)] {
+                    let w = PixelWindow { x, y, w: ww, h: hh };
+                    let t = render_target(&q, fw, fh, w, context);
+                    let mut args = tool_args("render", t.clone());
+                    args["stage_cache"] = json!("on");
+                    args["stage_cache_budget_bytes"] = json!(512 << 20);
+                    let rendered = call(&mut h, &args);
+                    let image = pixels(&rendered);
+                    let meta: Value = serde_json::from_str(rendered.content[1]["text"].as_str().unwrap()).unwrap();
+                    let valid = win(&t["validRegion"]);
+                    let (mut worst, mut inner, mut changed, mut proxy_inner) = (0u8, 0u8, 0usize, 0u8);
+                    let mut inner_sum = 0u64;
+                    for yy in 0..w.h {
+                        for xx in 0..w.w {
+                            for c in 0..3 {
+                                let d = image.data[yy * w.w + xx][c].abs_diff(whole.data[(yy + y) * fw + xx + x][c]);
+                                worst = worst.max(d);
+                                if xx + x >= valid.x && xx + x < valid.x + valid.w && yy + y >= valid.y && yy + y < valid.y + valid.h {
+                                    inner = inner.max(d);
+                                    inner_sum += d as u64;
+                                    if d > 0 {
+                                        changed += 1;
+                                    }
+                                    if let Some(proxy) = &proxy_whole {
+                                        proxy_inner = proxy_inner.max(image.data[yy * w.w + xx][c].abs_diff(proxy.data[(yy + y) * fw + xx + x][c]));
+                                    }
+                                }
+                            }
+                        }
+                    }
+                    let mae = inner_sum as f64 / (valid.w * valid.h * 3) as f64;
+                    println!(
+                        "region pixels gpu={gpu} case={case} context={context} x={x} y={y} allMax={worst} innerMax={inner} innerMae={mae:.6} proxyInner={proxy_inner} changedChannels={changed} execution={} cache={}",
+                        meta["diagnostics"]["execution"], meta["diagnostics"]["stageCache"]
+                    );
+                    if gpu {
+                        assert_eq!(meta["diagnostics"]["execution"]["outcome"], "gpu_success");
+                    }
+                    // A geometry error is not an allowable spatial-filter boundary difference.
+                    // Fixture regression bounds follow measured results, not a general overlay acceptance threshold.
+                    assert!(inner <= if case == "dehaze" { 3 } else { 1 }, "{case} gpu={gpu} inner={inner}");
+                    assert_eq!(h.session.develop_of(PhotoId(1)).unwrap().hash64(), hash);
+                }
+            }
+        }
+    }
+    lightcraft_engine::gpu::set_enabled(true);
+}
