+    #[test]
+    fn genzoroom_geometry_tracks_coordinates_not_tone_quality_or_size() {
+        let src = Rgb32f::from_fn(96, 64, |x, y| [0.03 + (x + y) as f32 / 600.0; 3]);
+        let mut s = DevelopSettings::default();
+        let info = SourceInfo::default();
+        let render_meta = |s: &DevelopSettings, edge, draft| {
+            let mut req = RenderRequest::fit(edge, edge);
+            if draft {
+                req.quality = pipeline::Quality::Draft;
+            }
+            let r = pipeline::render(&src, &info, s, &req);
+            frame_metadata(r.frame.as_ref().unwrap(), (6001, 4001), "source-one", r.image.width, r.image.height).unwrap()
+        };
+        let full = render_meta(&s, 32, false);
+        assert_eq!(full["nativeWidth"], 6001);
+        assert_eq!(full["nativeHeight"], 4001);
+        s.light.exposure = 1.0;
+        s.optics.vignetting = 20.0;
+        assert_eq!(full["geometryId"], render_meta(&s, 64, true)["geometryId"]);
+        s.crop.flip_h = true;
+        assert_ne!(full["geometryId"], render_meta(&s, 32, false)["geometryId"]);
+        s.crop.flip_h = false;
+        s.optics.distortion = 20.0;
+        assert_ne!(full["geometryId"], render_meta(&s, 32, false)["geometryId"]);
+        let r = pipeline::render(&src, &info, &s, &RenderRequest::fit(32, 32));
+        let frame = r.frame.as_ref().unwrap();
+        let other = frame_metadata(frame, (6001, 4001), "source-two", r.image.width, r.image.height).unwrap();
+        assert_ne!(other["geometryId"], render_meta(&s, 32, false)["geometryId"]);
+        let mut invalid = frame.clone();
+        invalid.crop.angle = f64::NAN;
+        assert!(matches!(frame_metadata(&invalid, (6001, 4001), "source-two", r.image.width, r.image.height), Err("preview_geometry_mismatch")));
