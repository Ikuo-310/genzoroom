     use super::*;
 
+    #[test]
+    fn genzoroom_before_keeps_native_geometry_without_copying_after_optics() {
+        let mut h = Headless::demo();
+        let id = h.session.active().unwrap();
+        let import = h.session.catalog.photo(id).unwrap().import_defaults();
+        let mut after = (*h.session.catalog.photo(id).unwrap().develop).clone();
+        after.optics.distortion = 25.0;
+        after.light.exposure = 1.5;
+        h.session.set_develop(id, after, "fixture").unwrap();
+        h.session.execute("crop.set", &json!({"rect":[0.1,0.2,0.9,0.8]})).unwrap();
+        h.session.execute("photo.rotateRight", &json!({})).unwrap();
+        h.call("command", json!({"id":"beforeAfter.setBefore","params":{"source":"import"}})).unwrap();
+        let before = h.session.render_job(id, 64, 64, true, true).unwrap();
+        let after = h.session.render_job(id, 64, 64, false, true).unwrap();
+        assert_eq!(before.settings.crop, after.settings.crop);
+        assert_eq!(before.settings.orientation, after.settings.orientation);
+        assert_eq!(before.settings.optics.distortion, import.optics.distortion);
+        assert_eq!(before.settings.light.exposure, import.light.exposure);
+        assert_eq!(serde_json::to_value(before.settings.wb).unwrap(), serde_json::to_value(import.wb).unwrap());
+        let meta = h.call("ui.render", json!({"id":id.0,"size":64,"before":true})).unwrap();
+        assert_eq!(meta["geometry"]["crop"], serde_json::to_value(after.settings.crop).unwrap());
+        assert_eq!(meta["geometry"]["orientation"], serde_json::to_value(after.settings.orientation).unwrap());
+        assert_eq!(meta["effectiveBeforeFingerprint"], format!("{:016x}",before.settings.hash64()));
+    }
