+/// GenzoRoom's extension keeps After compatible and renders import Before without mutations.
+#[test]
+fn genzoroom_native_before_preview() {
+    let mut server = Server::new(Box::new(Headless::demo()));
+    let setup = session(&mut server, &[
+        json!({"jsonrpc":"2.0","id":1,"method":"tools/list"}),
+        call(2, "query_photos", json!({"limit":1})),
+    ]);
+    let tools = setup[0]["result"]["tools"].as_array().unwrap();
+    let preview = tools.iter().find(|t| t["name"] == "render_preview").unwrap();
+    assert_eq!(preview["inputSchema"]["properties"]["before"]["type"], "boolean");
+    let id = setup[1]["result"]["structuredContent"]["photos"][0]["id"].as_u64().unwrap();
+    let images = session(&mut server, &[
+        call(3, "run_command", json!({"command":"library.select", "params":{"ids":[id],"active":id,"mode":"replace"}})),
+        call(4, "run_command", json!({"command":"beforeAfter.setBefore", "params":{"source":"import"}})),
+        call(5, "render_preview", json!({"id":id,"max_side":64})),
+        call(6, "set_develop", json!({"id":id,"values":{"light.exposure":1.5}})),
+        call(7, "render_preview", json!({"id":id,"max_side":64,"before":true})),
+        call(8, "render_preview", json!({"id":id,"max_side":64,"before":false})),
+        call(9, "get_develop", json!({"id":id})),
+    ]);
+    for item in &images { assert_eq!(item["result"]["isError"], false, "{item}"); }
+    let meta = |index:usize| -> Value {
+        let text = images[index]["result"]["content"].as_array().unwrap().iter().find(|c|c["type"] == "text").unwrap();
+        serde_json::from_str(text["text"].as_str().unwrap()).unwrap()
+    };
+    assert_eq!(meta(2)["kind"], "after");
+    assert_eq!(meta(4)["kind"], "before");
+    assert_eq!(meta(5)["kind"], "after");
+    assert_eq!(meta(4)["beforeFingerprint"], images[1]["result"]["structuredContent"]["beforeFingerprint"]);
+    assert!(meta(4)["effectiveBeforeFingerprint"].is_string());
+    let original = mean_of(&images[2]["result"]);
+    let before = mean_of(&images[4]["result"]);
+    let after = mean_of(&images[5]["result"]);
+    assert_eq!(original, before);
+    assert!(after.0 > before.0);
+    assert_eq!((before.1,before.2),(after.1,after.2));
+    assert_eq!(images[6]["result"]["structuredContent"]["light"]["exposure"], 1.5);
