+use lightcraft_raster::{Rgb32f, Rgba8};
+use std::sync::Arc;
+
+fn host(settings: DevelopSettings) -> Headless {
+    host_size(settings, 512, 384)
+}
+fn host_size(settings: DevelopSettings, width: usize, height: usize) -> Headless {
+    host_kind(settings, width, height, false)
+}
+fn host_kind(settings: DevelopSettings, width: usize, height: usize, raw: bool) -> Headless {
+    let mut s = Session::new();
+    let mut p = Photo::new(PhotoId(1), Source::File { path: "unused-fixture.png".into() }, "fixture.png", "PNG", width as u32, height as u32, "");
+    if raw {
+        p.kind = lightcraft_engine::catalog::MediaKind::Raw;
+        p.format = "DNG".into();
+        p.as_shot_wb = Some((5500.0, 7.0));
+    }
+    p.develop = Arc::new(settings);
+    s.catalog.apply(Op::AddPhoto { photo: Box::new(p) }).unwrap();
+    let source = Arc::new(Rgb32f::from_fn(width, height, |x, y| {
+        [(0.03 + x as f32 / (width + 28) as f32), 0.1 + y as f32 / (height + 66) as f32, 0.2 + ((x * 7 + y * 13) % 61) as f32 / 130.0]
+    }));
+    for level in [SourceLevel::Thumb, SourceLevel::Preview, SourceLevel::Full] {
+        s.media.insert(PhotoId(1), level, source.clone());
+    }
+    Headless::new(s)
+}
+fn target(h: &mut Headless, before: bool) -> Value {
+    let p = h.session.catalog.photo(PhotoId(1)).unwrap();
+    let original = (p.width as usize, p.height as usize);
+    let mut job = h.session.render_job(PhotoId(1), 512, 512, before, true).unwrap();
+    let loaded = job.source.load_source().unwrap();
+    let src = loaded.image_for(job.settings.denoise_amount());
+    let info = loaded.info_or(job.info.clone());
+    let plan = pipeline::plan(&src, &info, &job.settings, &job.request);
+    let source_key = format!("{:?}", job.source_key.unwrap());
+    let meta = crate::preview::frame_metadata(&plan.frame, original, &source_key, plan.w, plan.h).unwrap();
+    drop(plan);
+    job.source = SourceRef::Loaded(Box::new(loaded));
+    let identity = if before { json!({"kind":"before","beforeKey":"f".repeat(64)}) } else { json!({"kind":"after","revision":2}) };
+    let mut i = json!({"assetId":"12345678-1234-4234-9234-123456789abc","sourceId":"b".repeat(64),"generation":1,"documentToken":"c".repeat(32)});
+    i.as_object_mut().unwrap().extend(identity.as_object().unwrap().clone());
+    json!({"contractVersion":1,"mode":"region","quality":"full","geometryId":meta["geometryId"],"identity":i,
+        "documentRevision":2,"viewGeneration":3,"requestId":"d".repeat(32),"desiredLongEdge":512})
+}
+fn render_target(q: &Value, fw: usize, fh: usize, w: PixelWindow, context: usize) -> Value {
+    let mut t = q.clone();
+    t.as_object_mut().unwrap().remove("desiredLongEdge");
+    t["fullWidth"] = json!(fw);
+    t["fullHeight"] = json!(fh);
+    t["window"] = wjson(w);
+    t["context"] = json!(context);
+    t["prefetch"] = json!(0);
+    let x = w.x + if w.x == 0 { 0 } else { context };
+    let y = w.y + if w.y == 0 { 0 } else { context };
+    let right = w.x + w.w - if w.x + w.w == fw { 0 } else { context };
+    let bottom = w.y + w.h - if w.y + w.h == fh { 0 } else { context };
+    t["validRegion"] = json!({"x":x,"y":y,"w":right-x,"h":bottom-y});
+    t
+}
+fn tool_args(op: &str, t: Value) -> Value {
+    json!({"id":"1","region_contract":1,"operation":op,"target":t})
+}
+fn pixels(r: &ToolResult) -> Rgba8 {
+    assert!(!r.is_error, "{:?}", r.content);
+    let bytes = crate::base64_decode(r.image().unwrap().0).unwrap();
+    lightcraft_codecs::decode(&bytes, Default::default()).unwrap().to_srgb8()
+}
+#[test]
+fn c0_shared_coordinate_fixtures() {
+    let fixtures: Value = serde_json::from_str(include_str!("../region_fixtures.json")).unwrap();
+    let contract: Value = serde_json::from_str(include_str!("../region_contract.json")).unwrap();
+    assert_eq!(contract["c1InitialBudget"]["maxPngBytes"], PNG_LIMIT);
+    assert_eq!(contract["c1InitialBudget"]["maxMcpLineBytes"], LINE_LIMIT);
+    assert_eq!(contract["c1InitialBudget"]["maxSide"], MAX_SIDE);
+    assert_eq!(contract["c1InitialBudget"]["maxPixels"], MAX_PIXELS);
+    for f in fixtures.as_array().unwrap() {
+        let i = &f["input"];
+        let g = &i["geometry"];
+        let v = &i["view"];
+        let full = &i["full"];
+        let (nw, nh, s, vw, vh) = (
+            g["nativeWidth"].as_f64().unwrap(),
+            g["nativeHeight"].as_f64().unwrap(),
+            v["scale"].as_f64().unwrap(),
+            v["width"].as_f64().unwrap(),
+            v["height"].as_f64().unwrap(),
+        );
+        let l = (vw - nw * s) / 2.0 + v["panX"].as_f64().unwrap();
+        let top = (vh - nh * s) / 2.0 + v["panY"].as_f64().unwrap();
+        let r = [(-l / s).max(0.0), (-top / s).max(0.0), ((vw - l) / s).min(nw), ((vh - top) / s).min(nh)];
+        for (k, a) in ["x0", "y0", "x1", "y1"].into_iter().zip(r) {
+            assert!((a - f["expected"]["nativeVisibleRect"][k].as_f64().unwrap()).abs() < 1e-9, "{}", f["name"]);
+        }
+        let fw = full["fullWidth"].as_f64().unwrap();
+        let fh = full["fullHeight"].as_f64().unwrap();
+        let grid = i["budget"]["grid"].as_f64().unwrap();
+        let margin = i["context"].as_f64().unwrap() + i["prefetch"].as_f64().unwrap();
+        let x = (((r[0] * fw / nw - margin).floor() / grid).floor() * grid).max(0.0);
+        let y = (((r[1] * fh / nh - margin).floor() / grid).floor() * grid).max(0.0);
+        let right = (((r[2] * fw / nw + margin).ceil() / grid).ceil() * grid).min(fw);
+        let bottom = (((r[3] * fh / nh + margin).ceil() / grid).ceil() * grid).min(fh);
+        assert_eq!(
+            json!({"x":x as usize,"y":y as usize,"w":(right-x) as usize,"h":(bottom-y) as usize}),
+            f["expected"]["contextWindow"],
+            "{}",
+            f["name"]
+        );
+    }
