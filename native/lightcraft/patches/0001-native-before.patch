+#[test]
+fn png_file_limit_and_oversized_target_fail_closed() {
+    struct Oversized;
+    impl Backend for Oversized {
+        fn call(&mut self, _: &str, p: Value) -> Result<Value, String> {
+            std::fs::write(p["path"].as_str().unwrap(), vec![0; PNG_LIMIT + 1]).unwrap();
+            Ok(json!({}))
+        }
+        fn has_ui(&self) -> bool {
+            false
+        }
+        fn region_contract(&self) -> bool {
+            true
+        }
+        fn describe(&self) -> String {
+            "fixture".into()
+        }
+    }
+    let mut h = host(DevelopSettings::default());
+    let q = target(&mut h, false);
+    let t = render_target(&q, 512, 384, PixelWindow { x: 0, y: 0, w: 128, h: 128 }, 0);
+    let r = call(&mut Oversized, &tool_args("render", t.clone()));
+    assert!(r.is_error);
+    assert!(r.content[0]["text"].as_str().unwrap().contains("region_budget_exceeded"));
+    let mut bad = t;
+    bad["window"]["w"] = json!(2049);
+    assert!(call(&mut h, &tool_args("render", bad)).is_error);
+    let huge = Photo::new(PhotoId(2), Source::File { path: "must-not-decode.raw".into() }, "large", "DNG", 65536, 65536, "");
+    h.session.catalog.apply(Op::AddPhoto { photo: Box::new(huge) }).unwrap();
+    let mut query = q;
+    query["desiredLongEdge"] = json!(65536);
+    let mut args = tool_args("plan", query);
+    args["id"] = json!("2");
+    let r = call(&mut h, &args);
+    assert!(r.is_error);
+    assert!(r.content[0]["text"].as_str().unwrap().contains("region_budget_exceeded"));
+}
