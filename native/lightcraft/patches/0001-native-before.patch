+#[test]
+fn region_before_draft_full_cache_and_cpu_fallback() {
+    lightcraft_engine::gpu::set_enabled(true);
+    let mut settings = DevelopSettings::default();
+    settings.light.exposure = 0.7;
+    let mut h = host(settings);
+    let q = target(&mut h, false);
+    let before_q = target(&mut h, true);
+    assert_eq!(q["geometryId"], before_q["geometryId"]);
+    let w = PixelWindow { x: 128, y: 96, w: 256, h: 192 };
+    let full = render_target(&q, 512, 384, w, 32);
+    let before = render_target(&before_q, 512, 384, w, 32);
+    let after_pixels = pixels(&call(&mut h, &tool_args("render", full.clone())));
+    let before_pixels = pixels(&call(&mut h, &tool_args("render", before.clone())));
+    assert_eq!((after_pixels.width, after_pixels.height), (before_pixels.width, before_pixels.height));
+    assert_ne!(after_pixels, before_pixels);
+    let mut draft = full.clone();
+    draft["quality"] = json!("draft");
+    let d = call(&mut h, &tool_args("render", draft));
+    assert!(!d.is_error);
+    let meta: Value = serde_json::from_str(d.content[1]["text"].as_str().unwrap()).unwrap();
+    assert_eq!(meta["response"]["window"], full["window"]);
+    assert_eq!(meta["response"]["quality"], "draft");
+    let mut tiny = tool_args("render", full.clone());
+    tiny["stage_cache"] = json!("on");
+    tiny["stage_cache_budget_bytes"] = json!(1);
+    let t = call(&mut h, &tiny);
+    assert_eq!(pixels(&t), after_pixels);
+    let meta: Value = serde_json::from_str(t.content[1]["text"].as_str().unwrap()).unwrap();
+    assert_eq!(meta["diagnostics"]["stageCache"]["reason"], "budget");
+    if !lightcraft_engine::gpu::available() {
+        lightcraft_testkit::skip!(Gpu, "Region fault injection requires an adapter");
+        return;
+    }
+    lightcraft_engine::gpu::inject_fault(lightcraft_engine::gpu::Fault::OutOfMemory);
+    let failed_gpu = call(&mut h, &tool_args("render", full));
+    assert!(!failed_gpu.is_error);
+    let meta: Value = serde_json::from_str(failed_gpu.content[1]["text"].as_str().unwrap()).unwrap();
+    assert_eq!(meta["diagnostics"]["execution"]["outcome"], "cpu_fallback");
+    lightcraft_engine::gpu::reset_failures();
+    assert!(!call(&mut h, &tool_args("render", before)).is_error);
+}
