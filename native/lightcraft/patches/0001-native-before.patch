+//! GenzoRoom's opt-in preview envelope; legacy callers keep the original image contract.
+use std::sync::Arc;
+
+use lightcraft_engine::{
+    gpu, memory,
+    pipeline::{StageCache, geometry::Frame},
+};
+use serde_json::{Value, json};
+use sha2::{Digest, Sha256};
+
+#[derive(Clone, Copy)]
+pub(crate) struct Options {
+    pub adaptive: bool,
+    pub draft: bool,
+    pub budget: Option<usize>,
+}
+
+impl Options {
+    pub fn parse(p: &Value) -> Result<Self, &'static str> {
+        if p.get("before").is_some_and(|v| !v.is_boolean()) {
+            return Err("preview_invalid_contract");
+        }
+        let adaptive = ["quality", "preview_contract", "stage_cache", "stage_cache_budget_bytes"].iter().any(|k| p.get(k).is_some());
+        let draft = match p.get("quality") {
+            None => false,
+            Some(Value::String(s)) if s == "full" => false,
+            Some(Value::String(s)) if s == "draft" => true,
+            _ => return Err("preview_invalid_quality"),
+        };
+        if let Some(v) = p.get("preview_contract") {
+            if v.as_u64() != Some(1) {
+                return Err("preview_invalid_contract");
+            }
+        }
+        let on = match p.get("stage_cache") {
+            None => false,
+            Some(Value::String(s)) if s == "off" => false,
+            Some(Value::String(s)) if s == "on" => true,
+            _ => return Err("preview_invalid_stage_cache"),
+        };
+        let budget = if on {
+            let n = p
+                .get("stage_cache_budget_bytes")
+                .and_then(Value::as_u64)
+                .and_then(|n| usize::try_from(n).ok())
+                .filter(|n| *n > 0 && *n <= memory::budget())
+                .ok_or("preview_invalid_stage_cache")?;
+            Some(n)
+        } else {
+            if p.get("stage_cache_budget_bytes").is_some() {
+                return Err("preview_invalid_stage_cache");
+            }
+            None
+        };
+        Ok(Self { adaptive, draft, budget })
+    }
+}
+
+pub(crate) fn error(code: &str) -> crate::tools::ToolResult {
+    let safe = match code {
+        "preview_invalid_quality"
+        | "preview_invalid_contract"
+        | "preview_invalid_stage_cache"
+        | "preview_unsupported"
+        | "preview_geometry_unavailable"
+        | "preview_geometry_mismatch"
+        | "preview_budget_exceeded"
+        | "preview_render_failed" => code,
+        _ => "preview_render_failed",
+    };
+    crate::tools::ToolResult::error(json!({"code":safe}).to_string())
+}
+
+pub(crate) fn frame_metadata(f: &Frame, original: (usize, usize), source: &str, width: usize, height: usize) -> Result<Value, &'static str> {
+    let (nw, nh) = f.native_size_at(original.0, original.1).ok_or("preview_geometry_unavailable")?;
+    let aspect = f.aspect();
+    let mut coordinates = vec![f.ow, f.oh, f.crop.angle, f.crop.rect.x0, f.crop.rect.y0, f.crop.rect.x1, f.crop.rect.y1];
+    if let Some(w) = &f.warp {
+        coordinates.extend([w.w, w.h, w.k1, w.lens_dist]);
+        coordinates.extend(w.ca);
+        coordinates.extend(w.persp.0);
+        if let Some(lens) = &w.lens {
+            if let Some(l) = &lens.warp {
+                coordinates.extend([l.center.x, l.center.y, l.radius]);
+                coordinates.extend(l.planes.iter().flatten().copied());
+            }
+            for l in lens.stages.iter().flatten() {
+                coordinates.extend([l.center.x, l.center.y, l.radius]);
+                coordinates.extend(l.planes.iter().flatten().copied());
+            }
+        }
+    }
+    if !aspect.is_finite()
+        || aspect <= 0.0
+        || width == 0
+        || height == 0
+        || f.src_w == 0
+        || f.src_h == 0
+        || f.fit(width, height) != (width, height)
+        || coordinates.iter().any(|n| !n.is_finite())
+    {
+        return Err("preview_geometry_mismatch");
+    }
+    // Vignetting changes gain, not coordinates. Do not invalidate geometry for a gain-only edit.
+    let warp = f.warp.as_ref().filter(|w| w.moves_pixels()).map(|w| {
+        let mut lens = w.lens;
+        if let Some(l) = &mut lens {
+            l.vignette = None;
+        }
+        json!({"perspective":w.persp,"k1":w.k1,"ca":w.ca,
+            "lens":if w.lens_dist == 0.0 {None} else {lens},"lensDist":w.lens_dist})
+    });
+    let descriptor = json!({"contract":1,"source":source,"original":[original.0,original.1],
+        "sourceAspect":f.src_w as f64 / f.src_h as f64,
+        "orientation":f.orient,"crop":f.crop,"flip":[f.flip_h,f.flip_v],"warp":warp});
+    let bytes = serde_json::to_vec(&descriptor).map_err(|_| "preview_geometry_unavailable")?;
+    let id = format!("{:x}", Sha256::digest(bytes));
+    Ok(json!({"geometryId":id,"nativeWidth":nw.round().max(1.0) as u64,
+        "nativeHeight":nh.round().max(1.0) as u64,"aspect":aspect,
+        "fullWidth":width,"fullHeight":height,"window":null}))
+}
+
+#[derive(Default)]
+pub(crate) struct StagePool {
+    slots: [Option<Arc<StageCache>>; 2],
+    signatures: [String; 2],
+    geometries: [String; 2],
+    budget: Option<usize>,
+    source: String,
+}
+
+impl StagePool {
+    pub fn source(&mut self, key: &str) {
+        if self.source != key {
+            self.clear();
+            self.source = key.to_string();
+        }
+    }
+
+    pub fn clear(&mut self) {
+        for cache in self.slots.iter().flatten() {
+            cache.clear();
+        }
+        self.slots = Default::default();
+        self.signatures = Default::default();
+        self.geometries = Default::default();
+    }
+
+    fn sizes(&self) -> (usize, usize) {
+        self.slots.iter().flatten().fold((0usize, 0usize), |(cpu, device), c| {
+            // Cross-cache/shared-source references are conservatively charged to each owner.
+            (cpu.saturating_add(c.retained_bytes()).saturating_add(gpu::stage_host_bytes(c)), device.saturating_add(gpu::stage_bytes(c)))
+        })
+    }
+
+    pub fn prepare(
+        &mut self,
+        side: usize,
+        signature: &str,
+        budget: Option<usize>,
+        edge: usize,
+        original: (usize, usize),
+    ) -> (Option<Arc<StageCache>>, bool) {
+        if self.budget != budget || budget.is_none() {
+            self.clear();
+            self.budget = budget;
+        }
+        let Some(limit) = budget else { return (None, false) };
+        if self.signatures[side] != signature {
+            self.slots[side] = None;
+            self.geometries[side].clear();
+            self.signatures[side] = signature.to_string();
+        }
+        // Two retained sizes per view; allow CPU+GPU planes and pinned host/device source copies.
+        // This bounds admission, not the renderer's transient working memory or process RSS.
+        let estimate = edge.checked_mul(edge).and_then(|n| n.checked_mul(512)).and_then(|n| {
+            original.0.checked_mul(original.1).map(|s| s.max(2560 * 2560)).and_then(|s| s.checked_mul(36)).and_then(|s| n.checked_add(s))
+        });
+        let (cpu, device) = self.sizes();
+        if estimate.and_then(|n| n.checked_add(cpu)?.checked_add(device)).is_none_or(|n| n > limit) {
+            self.slots[side] = None;
+            return (None, false);
+        }
+        let cache = self.slots[side].get_or_insert_with(|| Arc::new(StageCache::default())).clone();
+        (Some(cache), true)
+    }
+
+    pub fn geometry(&mut self, side: usize, id: &str) {
+        if !self.geometries[side].is_empty() && self.geometries[side] != id {
+            if let Some(c) = &self.slots[side] {
+                c.clear();
+            }
+        }
+        self.geometries[side] = id.to_string();
+    }
+
+    pub fn finish(&mut self, side: usize, budget: Option<usize>, applied: bool) -> Value {
+        let (cpu, device) = self.sizes();
+        let limit = budget.unwrap_or(0);
+        for slot in [1 - side, side] {
+            let (c, g) = self.sizes();
+            if c.saturating_add(g) <= limit {
+                break;
+            }
+            self.slots[slot] = None;
+        }
+        let (retained_cpu, retained_gpu) = self.sizes();
+        json!({"mode":if budget.is_some(){"on"}else{"off"},"applied":applied,
+            "reason":if budget.is_some() && !applied {"budget"} else {"none"},
+            "cpuBytes":cpu,"gpuBytes":device,"retainedBytes":retained_cpu.saturating_add(retained_gpu),"budgetBytes":limit})
+    }
+}
