+    #[test]
+    fn genzoroom_stage_pool_reuses_separates_and_enforces_the_total_budget() {
+        let mut pool = StagePool::default();
+        pool.source("source-one");
+        let limit = memory::budget();
+        let (after, applied) = pool.prepare(0, "geometry-one", Some(limit), 32, (32, 32), None);
+        assert!(applied);
+        let after = after.unwrap();
+        let src = Arc::new(Rgb32f::from_fn(32, 32, |x, y| [0.03 + (x + y) as f32 / 500.0; 3]));
+        let req = RenderRequest::fit(32, 32);
+        let mut s = DevelopSettings::default();
+        let first = pipeline::render_cached(&src, &SourceInfo::default(), &s, &req, &after);
+        assert_eq!(after.len(), 1);
+        let (same, _) = pool.prepare(0, "geometry-one", Some(limit), 32, (32, 32), None);
+        assert!(Arc::ptr_eq(&after, &same.unwrap()));
+        let (before, _) = pool.prepare(1, "before-import", Some(limit), 32, (32, 32), None);
+        assert!(!Arc::ptr_eq(&after, &before.unwrap()));
+        let mut draft = req;
+        draft.quality = pipeline::Quality::Draft;
+        s.detail.nr_luminance = 30.0;
+        let _ = pipeline::render_cached(&src, &SourceInfo::default(), &s, &draft, &after);
+        let final_full = pipeline::render_cached(&src, &SourceInfo::default(), &s, &req, &after);
+        let uncached = pipeline::render(&src, &SourceInfo::default(), &s, &req);
+        assert_eq!(final_full.image.data, uncached.image.data);
+        assert_ne!(first.image.data.len(), 0);
+        drop(after);
+        let retained = pool.finish(0, Some(limit), true);
+        assert!(retained["retainedBytes"].as_u64().unwrap() > 0);
+        assert!(retained["retainedBytes"].as_u64().unwrap() <= limit as u64);
+        // Exercise post-render eviction independently of the conservative admission estimate.
+        assert_eq!(pool.finish(0, Some(1), true)["retainedBytes"], 0);
+        assert!(pool.slots.iter().all(Option::is_none));
+        // Lowering the configured limit clears both sides before any new cache admission.
+        let (none, applied) = pool.prepare(0, "geometry-one", Some(1), 32, (32, 32), None);
+        assert!(none.is_none() && !applied);
+        assert_eq!(pool.finish(0, Some(1), false)["retainedBytes"], 0);
+        let _ = pool.prepare(0, "geometry-one", Some(limit), 32, (32, 32), None);
+        pool.source("source-two");
+        assert!(pool.slots.iter().all(Option::is_none));
+        let _ = pool.prepare(0, "geometry-one", None, 32, (32, 32), None);
+        assert_eq!(pool.finish(0, None, false)["retainedBytes"], 0);
+    }
