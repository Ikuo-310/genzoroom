+#[test]
+fn genzoroom_render_frame_is_the_effective_plan_without_a_second_decode() {
+    use lightcraft_geom::{Orientation, Point, Rect};
+    use lightcraft_develop::{EmbeddedLens, EmbeddedWarp, Upright};
+    let src = scene();
+    let info = SourceInfo { lens: Some(EmbeddedLens {
+        warp: Some(EmbeddedWarp { planes:[[1.0,0.01,0.0,0.0,0.001,0.002];3], center:Point::new(0.4,0.5),radius:0.6 }),
+        ..Default::default()
+    }), ..Default::default() };
+    let mut s = DevelopSettings::default();
+    s.crop.geometry.rect = Rect { x0: 0.1, y0: 0.2, x1: 0.9, y1: 0.8 };
+    s.crop.geometry.angle = 7.0;
+    s.crop.flip_h = true;
+    s.orientation = Orientation::Rotate90;
+    s.optics.distortion = 20.0;
+    s.optics.remove_ca = true;
+    s.geometry.constrain_crop = true;
+    s.geometry.upright = Upright::Level;
+    let req = RenderRequest::fit(96, 96);
+    let effective = s.effective();
+    let rendition = crate::settings_for(&effective, &req);
+    let expected = crate::plan(&src, &info, &rendition, &req);
+    let rendered = render(&src, &info, &s, &req);
+    let actual = rendered.frame.as_ref().unwrap();
+    assert_eq!(actual, &expected.frame);
+    assert_eq!((rendered.image.width, rendered.image.height), (expected.w, expected.h));
+    // Original dimensions are an independent decoder fact, including odd native dimensions.
+    let native = actual.native_size_at(6001, 4001).unwrap();
+    assert_eq!(native, (actual.crop.rect.width() * 4001.0, actual.crop.rect.height() * 6001.0));
+    let mut disabled = s.clone();
+    disabled.disabled_sections.push("optics".to_string());
+    let r = render(&src, &info, &disabled, &req);
+    let e = disabled.effective();
+    let rendition = crate::settings_for(&e, &req);
+    let p = crate::plan(&src, &info, &rendition, &req);
+    assert_eq!(r.frame.as_ref().unwrap(), &p.frame);
+}
