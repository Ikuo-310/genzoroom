+#[test]
+fn genzoroom_adaptive_quality_geometry_and_legacy_contract() {
+    let h=Headless::demo();
+    let id=h.session.active().unwrap().0;
+    let p=h.session.catalog.photo(lightcraft_engine::catalog::PhotoId(id)).unwrap();
+    let original=(p.width as u64,p.height as u64);
+    let mut server=Server::new(Box::new(h));
+    let replies=session(&mut server,&[
+        call(1,"render_preview",json!({"id":id,"max_side":32})),
+        call(2,"render_preview",json!({"id":id,"max_side":32,"preview_contract":1})),
+        call(3,"render_preview",json!({"id":id,"max_side":32,"quality":"draft"})),
+        call(4,"render_preview",json!({"id":id,"max_side":32,"quality":"full","before":true})),
+        call(5,"render_preview",json!({"id":id,"max_side":32,"quality":"draft","before":true})),
+        call(6,"get_develop",json!({"id":id})),
+        call(7,"set_develop",json!({"id":id,"values":{"light.exposure":1.5}})),
+        call(8,"render_preview",json!({"id":id,"max_side":64,"quality":"full"})),
+        call(9,"render_preview",json!({"id":id,"max_side":32,"before":true})),
+    ]);
+    let old=preview_metadata(&replies[0]["result"]);
+    assert_eq!(old.as_object().unwrap().keys().cloned().collect::<Vec<_>>(),["height","id","kind","width"]);
+    let full=preview_metadata(&replies[1]["result"]);
+    assert_eq!(full["frame"]["nativeWidth"],original.0);
+    assert_eq!(full["frame"]["nativeHeight"],original.1);
+    assert_eq!(full["frame"]["fullWidth"],full["width"]);
+    assert!(full["frame"]["window"].is_null());
+    assert!(full["frame"]["nativeWidth"].as_u64().unwrap()>full["width"].as_u64().unwrap());
+    assert_eq!(replies[0]["result"]["content"][0],replies[1]["result"]["content"][0]);
+    for (i,kind,quality) in [(1,"after","full"),(2,"after","draft"),(3,"before","full"),(4,"before","draft")] {
+        let meta=preview_metadata(&replies[i]["result"]);
+        assert_eq!(meta["previewContract"],1);
+        assert_eq!(meta["kind"],kind);
+        assert_eq!(meta["quality"],quality);
+        assert_eq!(meta["frame"]["geometryId"],full["frame"]["geometryId"]);
+        assert_eq!(meta["stageCache"]["retainedBytes"],0);
+        assert!(meta.get("path").is_none());
+        assert_eq!(mean_of(&replies[i]["result"]).1 as u64,meta["width"].as_u64().unwrap());
+    }
+    assert_eq!(full["frame"]["geometryId"],preview_metadata(&replies[7]["result"])["frame"]["geometryId"]);
+    assert!(preview_metadata(&replies[8]["result"]).get("previewContract").is_none());
+    assert_eq!(replies[5]["result"]["structuredContent"]["light"]["exposure"],0.0);
+}
