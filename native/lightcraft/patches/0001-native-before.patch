+    #[test]
+    fn genzoroom_frame_sidecar_preserves_single_decode_and_source_accept() {
+        use std::sync::atomic::{AtomicUsize,Ordering};
+        let mut session=crate::Session::with_demo();
+        let id=session.active().unwrap();
+        let mut job=session.render_job(id,32,32,false,true).unwrap();
+        let calls=Arc::new(AtomicUsize::new(0));
+        let count=calls.clone();
+        job.source=SourceRef::File { path:"synthetic-fixture".into(), max_edge:32,
+            loader:Some(Arc::new(move |_,_| {count.fetch_add(1,Ordering::SeqCst);
+                Ok((Rgb32f::from_fn(32,24,|_,_| [0.1;3]),SourceInfo::default()))})),
+            fallback:None,denoise:None };
+        let result=job.run();
+        assert!(result.loaded.is_some());
+        assert!(result.rendered.as_ref().unwrap().frame.is_some());
+        session.accept(&result);
+        let next=session.render_job(id,32,32,false,true).unwrap();
+        assert!(matches!(next.source,SourceRef::Loaded(_)));
+        let again=next.run();
+        assert!(again.loaded.is_none());
+        assert!(again.rendered.unwrap().frame.is_some());
+        assert_eq!(calls.load(Ordering::SeqCst),1);
+    }
+
 }
