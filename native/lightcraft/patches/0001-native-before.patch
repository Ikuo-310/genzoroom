+fn allocation_bytes(items: &[(usize, usize)]) -> usize {
+    let mut seen = Vec::new();
+    items.iter().fold(0usize, |n, &(id, bytes)| {
+        if seen.contains(&id) { n } else { seen.push(id); n.saturating_add(bytes) }
+    })
+}
