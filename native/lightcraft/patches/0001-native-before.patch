+    #[test]
+    fn genzoroom_cpu_two_entries_both_sides_and_lifecycle_are_bounded() {
+        let src = Arc::new(Rgb32f::from_fn(96, 72, |_, _| [0.2; 3]));
+        let mut pool = StagePool::default();
+        pool.source("one");
+        let budget = 512 << 20;
+        for side in 0..2 {
+            for edge in [32, 64, 32] {
+                let req = RenderRequest::fit(edge, edge);
+                let cache = cpu_prepare(&mut pool, side, &src, &req, budget).0.unwrap();
+                pipeline::render_cached(&src, &SourceInfo::default(), &DevelopSettings::default(), &req, &cache);
+                assert!(cache.len() <= 2);
+            }
+            assert_eq!(pool.slots[side].as_ref().unwrap().len(), 2);
+        }
+        assert!(!Arc::ptr_eq(pool.slots[0].as_ref().unwrap(), pool.slots[1].as_ref().unwrap()));
+        assert!(pool.finish(0, Some(budget), true)["retainedBytes"].as_u64().unwrap() <= budget as u64);
+        let before = pool.slots[1].as_ref().unwrap().clone();
+        let req = RenderRequest::fit(64, 64);
+        assert!(!cpu_prepare(&mut pool, 0, &src, &req, 1).1);
+        assert!(before.is_empty()); // A budget change invalidates both views.
+        assert!(pool.slots[0].is_none() && pool.slots[1].is_none());
+        cpu_prepare(&mut pool, 0, &src, &req, budget);
+        pool.source("two");
+        assert!(pool.slots.iter().all(Option::is_none));
+        cpu_prepare(&mut pool, 0, &src, &req, budget);
+        pool.prepare(0, "cpu-geometry", None, 64, (3990, 3000), None);
+        assert!(pool.slots.iter().all(Option::is_none));
+    }
