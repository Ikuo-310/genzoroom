+/// Capacity owned/pinned by all views, deduplicated across CPU and GPU caches.
+pub fn stage_capacities(caches: &[&StageCache]) -> (usize, usize) {
+    let mut host = Vec::new();
+    let mut device = Vec::new();
+    for c in caches {
+        host.extend(c.host_allocations(true));
+        #[cfg(not(target_arch = "wasm32"))]
+        if let Some(g) = c.peek_extension::<GpuStages>() {
+            let (h, d) = g.allocations(); host.extend(h); device.extend(d);
+        }
+    }
+    (allocation_bytes(&host), allocation_bytes(&device))
