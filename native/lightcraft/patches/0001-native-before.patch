+#[test]
+fn genzoroom_cache_budget_and_full_after_draft_match_uncached() {
+    let mut server=Server::new(Box::new(Headless::demo()));
+    let budget=lightcraft_engine::memory::budget();
+    let r=session(&mut server,&[
+        call(1,"render_preview",json!({"max_side":32,"quality":"draft","stage_cache":"on","stage_cache_budget_bytes":budget})),
+        call(2,"render_preview",json!({"max_side":32,"quality":"full","stage_cache":"on","stage_cache_budget_bytes":budget})),
+        call(3,"render_preview",json!({"max_side":32,"quality":"full","stage_cache":"off"})),
+        call(4,"render_preview",json!({"max_side":32,"quality":"full","stage_cache":"on","stage_cache_budget_bytes":1})),
+    ]);
+    for result in &r {
+        let meta=preview_metadata(&result["result"]);
+        assert!(meta["stageCache"]["retainedBytes"].as_u64().unwrap()<=meta["stageCache"]["budgetBytes"].as_u64().unwrap());
+    }
+    assert_eq!(r[1]["result"]["content"][0],r[2]["result"]["content"][0]);
+    let tiny=preview_metadata(&r[3]["result"]);
+    assert_eq!(tiny["stageCache"]["applied"],false);
+    assert_eq!(tiny["stageCache"]["reason"],"budget");
+    assert_eq!(tiny["stageCache"]["retainedBytes"],0);
+}
