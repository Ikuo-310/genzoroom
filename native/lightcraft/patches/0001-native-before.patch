+    fn genzoroom_mixed_gpu_buffers_use_capacity_admission() {
+        let src = Arc::new(Rgb32f::from_fn(32, 24, |_, _| [0.2; 3]));
+        let cache = Arc::new(StageCache::default());
+        if gpu::render(&src, &SourceInfo::default(), &DevelopSettings::default(), &RenderRequest::fit(32, 32), Some(&cache)).is_none() {
+            lightcraft_testkit::skip!(Gpu, "mixed-device allocation fixture requires GPU");
+            return;
+        }
+        let budget = 512 << 20;
+        let mut pool = StagePool { budget: Some(budget), ..Default::default() };
+        pool.slots[1] = Some(cache);
+        assert!(!pool.cpu_only());
