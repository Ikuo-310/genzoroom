+#[test]
+fn genzoroom_cpu_admission_deduplicates_sources_and_reserves_replacement_overlap() {
+    use crate::StageCache;
+    use std::sync::Arc;
+    let source = Arc::new(scene());
+    let other = Arc::new((*source).clone());
+    let s = DevelopSettings::default();
+    let info = SourceInfo::default();
+    let req = RenderRequest::fit(120, 120);
+    let cache = StageCache::default();
+    let fresh = StageCache::cpu_admission_bytes(&[], None, &source, &info, &s, &req).unwrap();
+    let pixels = 120 * 80;
+    assert_eq!(fresh, source.data.capacity() * 12 + pixels * 56);
+    crate::render_cached(&source, &info, &s, &req, &cache);
+    let warm = StageCache::cpu_admission_bytes(&[&cache], Some(&cache), &source, &info, &s, &req).unwrap();
+    assert_eq!(warm, cache.retained_bytes() + pixels * 32);
+    assert_eq!(warm, StageCache::cpu_admission_bytes(&[&cache, &cache], Some(&cache), &source, &info, &s, &req).unwrap());
+    let peer = StageCache::default();
+    crate::render_cached(&source, &info, &s, &req, &peer);
+    let both = StageCache::cpu_admission_bytes(&[&cache, &peer], Some(&cache), &source, &info, &s, &req).unwrap();
+    assert_eq!(both, cache.retained_bytes() + peer.retained_bytes() - source.data.capacity() * 12 + pixels * 32);
+    let changed = StageCache::cpu_admission_bytes(&[&cache], Some(&cache), &other, &info, &s, &req).unwrap();
+    assert_eq!(changed, cache.retained_bytes() + other.data.capacity() * 12 + pixels * 56);
+    let mut wb = s.clone();
+    wb.wb.mode = lightcraft_develop::WbMode::Custom;
+    wb.wb.tint += 10.0;
+    let replacing = StageCache::cpu_admission_bytes(&[&cache], Some(&cache), &source, &info, &wb, &req).unwrap();
+    assert_eq!(replacing, cache.retained_bytes() + pixels * 44); // sampled reused, old/new lin coexist
+    let mut spare = (*source).clone();
+    spare.data.reserve(100);
+    let spare = Arc::new(spare);
+    assert_eq!(StageCache::cpu_admission_bytes(&[], None, &spare, &info, &s, &req).unwrap(),
+        spare.data.capacity() * 12 + pixels * 56);
+}
