+        assert_eq!(full.image.width, 1024);
+        assert!(Arc::ptr_eq(&cache, &cpu_prepare(&mut pool, 0, &src, &req, budget).0.unwrap()));
+        let metadata = pool.finish(0, Some(budget), true);
+        assert!(metadata["retainedBytes"].as_u64().unwrap() > 0);
