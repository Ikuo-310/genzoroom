+        let (same, _) = pool.prepare(0, "geometry-one", Some(limit), 32, (32, 32), None);
+        assert!(Arc::ptr_eq(&after, &same.unwrap()));
+        let (before, _) = pool.prepare(1, "before-import", Some(limit), 32, (32, 32), None);
+        assert!(!Arc::ptr_eq(&after, &before.unwrap()));
