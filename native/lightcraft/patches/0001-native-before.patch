+pub fn stage_admission_bytes(caches: &[&StageCache], target: Option<&StageCache>, src: &Arc<Rgb32f>,
+    info: &SourceInfo, s: &DevelopSettings, req: &RenderRequest) -> Option<usize> {
+    #[cfg(not(target_arch = "wasm32"))]
+    {
+        // P0 reserves the CPU fallback's new planes and all old CPU entries.
+        let cpu = StageCache::cpu_admission_bytes(caches, target, src, info, s, req)?;
+        let mut host = Vec::new();
+        let mut device = Vec::new();
+        for c in caches {
+            host.extend(c.host_allocations(true));
+        }
+        host.push((Arc::as_ptr(src) as usize, src.data.capacity().checked_mul(12)?));
+        let cpu_existing = allocation_bytes(&host);
+        for c in caches {
+            if let Some(g) = c.peek_extension::<GpuStages>() {
+                let (h, d) = g.allocations(); host.extend(h); device.extend(d);
+            }
+        }
+        let effective = s.effective();
+        let rendition = lightcraft_pipeline::settings_for(&effective, req);
+        let plan = lightcraft_pipeline::plan(src, info, &rendition, req);
+        let empty = GpuStages::default();
+        let ext = target.and_then(|c| c.peek_extension::<GpuStages>());
+        let extra = ext.as_deref().unwrap_or(&empty).additional(src, &plan)?;
+        let mut required = allocation_bytes(&host).checked_add(allocation_bytes(&device))?
+            .checked_add(cpu.checked_sub(cpu_existing)?)?.checked_add(extra)?;
+        // Global source is not cache-owned. Reserve its old/new coexistence anyway;
+        // never make admission appear cheaper by moving a required upload outside the view.
+        required = required.checked_add(shared_source_bytes())?;
