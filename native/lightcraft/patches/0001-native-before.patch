+//! Independent, fail-closed Region contract. The caller owns view planning, LC owns effective geometry.
+use crate::{Backend, Headless, ToolResult};
+use lightcraft_engine::{
+    catalog::PhotoId,
+    media::SourceRef,
+    pipeline::{self, PixelWindow},
+};
+use serde_json::{Value, json};
+use std::time::Instant;
+
+pub(crate) const PNG_LIMIT: usize = 9 * 1024 * 1024;
+pub(crate) const LINE_LIMIT: usize = 13 * 1024 * 1024;
+const MAX_SIDE: usize = 2048;
+const MAX_PIXELS: usize = 2_097_152;
+
+pub(crate) fn schema() -> Value {
+    serde_json::from_str(include_str!("region_schema.json")).unwrap_or(Value::Null)
+}
+pub(crate) fn tool() -> Value {
+    let defs = schema();
+    json!({"name":"render_region_preview","title":"Region preview","description":"Plan or render an explicit window; never changes selection or develop settings.",
+        "inputSchema":{"type":"object","additionalProperties":false,"required":["id","region_contract","operation","target"],
+        "properties":{"id":{"type":"string"},"region_contract":{"type":"integer","enum":[1]},
+        "operation":{"type":"string","enum":["plan","render"]},
+        "target":{"oneOf":[defs["$defs"]["frameRequest"],defs["$defs"]["request"]]},
+        "stage_cache":{"type":"string","enum":["off","on"]},"stage_cache_budget_bytes":{"type":"integer","minimum":1}}}})
+}
+
+// Only the small vocabulary in the checked-in C0 schemas is implemented; unknown schemas fail closed.
+pub(crate) fn validate(v: &Value, s: &Value) -> bool {
+    let Some(spec) = s.as_object() else { return false };
+    if spec.keys().any(|k| {
+        !["oneOf", "const", "enum", "type", "properties", "required", "additionalProperties", "minimum", "maximum", "exclusiveMinimum", "pattern"]
+            .contains(&k.as_str())
+    }) {
+        return false;
+    }
+    if let Some(one) = s.get("oneOf").and_then(Value::as_array) {
+        return one.iter().filter(|s| validate(v, s)).count() == 1;
+    }
+    if let Some(c) = s.get("const") {
+        return v == c;
+    }
+    if let Some(e) = s.get("enum").and_then(Value::as_array) {
+        if !e.contains(v) {
+            return false;
+        }
+    }
+    match s["type"].as_str() {
+        Some("object") => {
+            if s["additionalProperties"] != false {
+                return false;
+            }
+            let (Some(o), Some(p), Some(r)) = (v.as_object(), s["properties"].as_object(), s["required"].as_array()) else { return false };
+            r.iter().all(|k| k.as_str().is_some_and(|k| o.contains_key(k))) && o.iter().all(|(k, v)| p.get(k).is_some_and(|s| validate(v, s)))
+        }
+        Some("integer") | Some("number") => {
+            let Some(n) = v.as_f64().filter(|n| n.is_finite()) else { return false };
+            (s["type"] != "integer" || v.as_u64().is_some())
+                && s.get("minimum").and_then(Value::as_f64).is_none_or(|m| n >= m)
+                && s.get("maximum").and_then(Value::as_f64).is_none_or(|m| n <= m)
+                && s.get("exclusiveMinimum").and_then(Value::as_f64).is_none_or(|m| n > m)
+        }
+        Some("string") => {
+            let Some(t) = v.as_str() else { return false };
+            match s.get("pattern").and_then(Value::as_str) {
+                None => true,
+                Some("^[a-f0-9]{64}$") => hex(t, 64),
+                Some("^[a-f0-9]{32}$") => hex(t, 32),
+                Some("^[a-f0-9]{8}(-[a-f0-9]{4}){3}-[a-f0-9]{12}$") => {
+                    t.len() == 36
+                        && t.bytes()
+                            .enumerate()
+                            .all(|(i, c)| if [8, 13, 18, 23].contains(&i) { c == b'-' } else { c.is_ascii_digit() || (b'a'..=b'f').contains(&c) })
+                }
+                _ => false,
+            }
+        }
+        _ => false,
+    }
+}
+fn hex(s: &str, n: usize) -> bool {
+    s.len() == n && s.bytes().all(|c| c.is_ascii_digit() || (b'a'..=b'f').contains(&c))
+}
+fn n(v: &Value, k: &str) -> usize {
+    v[k].as_u64().unwrap_or(usize::MAX as u64) as usize
+}
+fn win(v: &Value) -> PixelWindow {
+    PixelWindow { x: n(v, "x"), y: n(v, "y"), w: n(v, "w"), h: n(v, "h") }
+}
+fn wjson(w: PixelWindow) -> Value {
+    json!({"x":w.x,"y":w.y,"w":w.w,"h":w.h})
+}
+fn bounded(w: PixelWindow) -> bool {
+    w.w > 0 && w.h > 0 && w.w <= MAX_SIDE && w.h <= MAX_SIDE && w.w.checked_mul(w.h).is_some_and(|p| p <= MAX_PIXELS)
+}
+pub(crate) fn target_valid(t: &Value, plan: bool) -> bool {
+    let name = if plan { "frameRequest" } else { "request" };
+    if !validate(t, &schema()["$defs"][name]) {
+        return false;
+    }
+    if t["identity"]["kind"] == "after" && t["identity"]["revision"] != t["documentRevision"] {
+        return false;
+    }
+    if plan {
+        return true;
+    }
+    let (w, v, c, fw, fh) = (win(&t["window"]), win(&t["validRegion"]), n(t, "context"), n(t, "fullWidth"), n(t, "fullHeight"));
+    if !bounded(w) || w.x.checked_add(w.w).is_none_or(|x| x > fw) || w.y.checked_add(w.h).is_none_or(|y| y > fh) {
+        return false;
+    }
+    let x = w.x + if w.x == 0 { 0 } else { c };
+    let y = w.y + if w.y == 0 { 0 } else { c };
+    let Some(right) = (w.x + w.w).checked_sub(if w.x + w.w == fw { 0 } else { c }) else { return false };
+    let Some(bottom) = (w.y + w.h).checked_sub(if w.y + w.h == fh { 0 } else { c }) else { return false };
+    right > x && bottom > y && v == PixelWindow { x, y, w: right - x, h: bottom - y }
+}
+fn error(code: &str) -> ToolResult {
+    let code = match code {
+        "region_invalid_request"
+        | "region_unsupported"
+        | "region_geometry_mismatch"
+        | "region_geometry_source_missing"
+        | "region_geometry_native_frame_missing"
+        | "region_geometry_metadata_mismatch"
+        | "region_geometry_id_mismatch"
+        | "region_native_full_width_mismatch"
+        | "region_native_full_height_mismatch"
+        | "region_full_width_mismatch"
+        | "region_full_height_mismatch"
+        | "region_render_contract_mismatch"
+        | "region_render_width_mismatch"
+        | "region_render_height_mismatch"
+        | "region_budget_exceeded"
+        | "region_work_budget_exceeded"
+        | "region_render_failed" => code,
+        _ => "region_render_failed",
+    };
+    ToolResult::error(json!({"code":code}).to_string())
+}
+pub(crate) fn call(b: &mut dyn Backend, args: &Value) -> ToolResult {
+    if !b.region_contract() {
+        return error("region_unsupported");
+    }
+    let Some(o) = args.as_object() else { return error("region_invalid_request") };
+    if o.keys().any(|k| !["id", "region_contract", "operation", "target", "stage_cache", "stage_cache_budget_bytes"].contains(&k.as_str()))
+        || args["region_contract"].as_u64() != Some(1)
+        || !matches!(args["operation"].as_str(), Some("plan" | "render"))
+        || args["id"].as_str().and_then(|s| s.parse::<u64>().ok()).is_none()
+        || !target_valid(&args["target"], args["operation"] == "plan")
+    {
+        return error("region_invalid_request");
+    }
+    if crate::preview::Options::parse(args).is_err() {
+        return error("region_invalid_request");
+    }
+    let path = crate::tools::temp_path("region");
+    let mut p = args.clone();
+    p["path"] = json!(path.to_string_lossy());
+    let result = b.call("ui.region", p);
+    let output = match result {
+        Err(e) => error(&e),
+        Ok(meta) if args["operation"] == "plan" => {
+            if meta.to_string().len() <= 16 * 1024 {
+                ToolResult::json(meta)
+            } else {
+                error("region_budget_exceeded")
+            }
+        }
+        Ok(meta) => {
+            let read = std::fs::metadata(&path)
+                .ok()
+                .filter(|m| m.len() <= PNG_LIMIT as u64)
+                .and_then(|_| std::fs::read(&path).ok())
+                .filter(|bytes| bytes.len() <= PNG_LIMIT);
+            match read {
+                None => error("region_budget_exceeded"),
+                Some(bytes) if meta.to_string().len() <= 16 * 1024 => {
+                    let r = ToolResult {
+                        is_error: false,
+                        structured: None,
+                        content: vec![
+                            json!({"type":"image","mimeType":"image/png","data":crate::base64_encode(&bytes)}),
+                            json!({"type":"text","text":meta.to_string()}),
+                        ],
+                    };
+                    if r.to_value().to_string().len() + 4096 <= LINE_LIMIT { r } else { error("region_budget_exceeded") }
+                }
+                _ => error("region_budget_exceeded"),
+            }
+        }
+    };
+    let _ = std::fs::remove_file(path);
+    output
+}
+
+pub(crate) fn execute(h: &mut Headless, p: &Value) -> Result<Value, &'static str> {
+    let result = lightcraft_engine::guard::catch("region preview", || execute_inner(h, p)).unwrap_or(Err("region_render_failed"));
+    if result.is_err() {
+        h.stages.clear();
+    }
+    result
+}
+fn execute_inner(h: &mut Headless, p: &Value) -> Result<Value, &'static str> {
+    let started = Instant::now();
+    let t = &p["target"];
+    let planning = p["operation"] == "plan";
+    if !target_valid(t, planning) {
+        return Err("region_invalid_request");
+    }
+    let id = PhotoId(p["id"].as_str().and_then(|s| s.parse().ok()).ok_or("region_invalid_request")?);
+    let before = t["identity"]["kind"] == "before";
+    let photo = h.session.catalog.photo(id).ok_or("region_render_failed")?;
+    let original = (photo.width as usize, photo.height as usize);
+    let baseline = photo.import_defaults().hash64();
+    let size = if planning {
+        t["desiredLongEdge"].as_f64().ok_or("region_invalid_request")?.ceil() as usize
+    } else {
+        n(t, "fullWidth").max(n(t, "fullHeight"))
+    };
+    // Overscan crop can enlarge the logical Native frame; cap against its actual Plan below.
+    let size = size.max(1);
+    let mut job = h
+        .session
+        .render_job(id, if planning { size } else { n(t, "fullWidth") }, if planning { size } else { n(t, "fullHeight") }, before, true)
+        .ok_or("region_render_failed")?;
+    if t["quality"] == "draft" {
+        job = job.draft();
+    }
+    let source_key = format!("{:?}", job.source_key.ok_or("region_geometry_source_missing")?);
+    // Window output bounds do not bound a full RAW decode. Reject impossible source reservations first.
+    if job.level == lightcraft_engine::media::SourceLevel::Full
+        && !matches!(job.source, SourceRef::Loaded(_))
+        && original.0.checked_mul(original.1).and_then(|n| n.checked_mul(36)).is_none_or(|n| n > lightcraft_engine::memory::budget())
+    {
+        return Err("region_budget_exceeded");
+    }
+    let decoded = job.source.load_source().map_err(|_| "region_render_failed")?;
+    let source = decoded.image_for(job.settings.denoise_amount());
+    let info = decoded.info_or(job.info.clone());
+    let mut whole = pipeline::plan(&source, &info, &job.settings, &job.request);
+    let native = whole.frame.native_size_at(original.0, original.1).ok_or("region_geometry_native_frame_missing")?;
+    let (nw, nh) = (native.0.round().max(1.0) as usize, native.1.round().max(1.0) as usize);
+    if nw > 65536 || nh > 65536 {
+        return Err("region_budget_exceeded");
+    }
+    if planning && (whole.w > nw || whole.h > nh) {
+        drop(whole);
+        job.request.max_w = job.request.max_w.min(nw);
+        job.request.max_h = job.request.max_h.min(nh);
+        whole = pipeline::plan(&source, &info, &job.settings, &job.request);
+    }
+    let meta = crate::preview::frame_metadata(&whole.frame, original, &source_key, whole.w, whole.h)
+        .map_err(|_| "region_geometry_metadata_mismatch")?;
+    if meta["geometryId"] != t["geometryId"] {
+        return Err("region_geometry_id_mismatch");
+    }
+    if whole.w > nw {
+        return Err("region_native_full_width_mismatch");
+    }
+    if whole.h > nh {
+        return Err("region_native_full_height_mismatch");
+    }
+    let (fw, fh) = (whole.w, whole.h);
+    drop(whole);
+    h.session.accept_preview_source(&job, decoded.clone());
+    let mut response = t.clone();
+    response["contractVersion"] = json!(1);
+    response["mode"] = json!("region");
+    response["kind"] = json!(if before { "before" } else { "after" });
+    response["quality"] = json!(if job.request.quality == pipeline::Quality::Draft { "draft" } else { "full" });
+    response["geometryId"] = meta["geometryId"].clone();
+    response["fullWidth"] = json!(fw);
+    response["fullHeight"] = json!(fh);
+    let mut diagnostics = json!({"sourceLevel":format!("{:?}",job.level),"sourceHostBytes":source.data.capacity().saturating_mul(std::mem::size_of::<[f32;3]>()),
+        "sourceCacheBytes":h.session.media.held(),"nativeMs":0});
+    if before {
+        diagnostics["beforeFingerprint"] = json!(format!("{baseline:016x}"));
+        diagnostics["effectiveBeforeFingerprint"] = json!(format!("{:016x}", job.settings.hash64()));
+    }
+    if planning {
+        response["nativeWidth"] = json!(nw);
+        response["nativeHeight"] = json!(nh);
+        response["fullWidth"] = json!(fw);
+        response["fullHeight"] = json!(fh);
+        diagnostics["nativeMs"] = json!(started.elapsed().as_secs_f64() * 1000.0);
+        return Ok(json!({"response":response,"diagnostics":diagnostics}));
+    }
+    if (fw, fh) != (n(t, "fullWidth"), n(t, "fullHeight")) {
+        if fw != n(t, "fullWidth") {
+            return Err("region_full_width_mismatch");
+        }
+        return Err("region_full_height_mismatch");
+    }
+    let w = win(&t["window"]);
+    let mut region = if before { h.session.region_job_before(id, fw, fh, w, true) } else { h.session.region_job(id, fw, fh, w, true) }
+        .ok_or("region_work_budget_exceeded")?;
+    if t["quality"] == "draft" {
+        region = region.draft();
+    }
+    // Return the job's actual contract, never silently relabel a different quality/window.
+    if response["quality"] != if region.request.quality == pipeline::Quality::Draft { "draft" } else { "full" } || region.request.window != Some(w) {
+        return Err("region_render_contract_mismatch");
+    }
+    response["window"] = wjson(region.request.window.ok_or("region_render_contract_mismatch")?);
+    region.source = SourceRef::Loaded(Box::new(decoded.clone()));
+    region.info = info.clone();
+    let actual = pipeline::plan(&source, &info, &region.settings, &region.request);
+    let work = PixelWindow {
+        x: w.x.checked_sub(actual.keep.map_or(0, |k| k.x)).ok_or("region_work_budget_exceeded")?,
+        y: w.y.checked_sub(actual.keep.map_or(0, |k| k.y)).ok_or("region_work_budget_exceeded")?,
+        w: actual.w,
+        h: actual.h,
+    };
+    if !bounded(work)
+        || work.x.checked_add(work.w).is_none_or(|r| r > fw || r < w.x + w.w)
+        || work.y.checked_add(work.h).is_none_or(|b| b > fh || b < w.y + w.h)
+    {
+        return Err("region_work_budget_exceeded");
+    }
+    drop(actual);
+    let options = crate::preview::Options::parse(p).map_err(|_| "region_invalid_request")?;
+    h.stages.source(&format!("{}:{source_key}", id.0));
+    h.stages.configure(options.budget);
+    let signature = format!(
+        "{}:{source_key}:{:?}:{:?}:{:?}:{:?}:{:?}:{:?}",
+        id.0,
+        region.settings.crop,
+        region.settings.orientation,
+        region.settings.optics,
+        region.settings.geometry,
+        region.settings.profile,
+        if before { baseline } else { 0 }
+    );
+    let side = usize::from(before);
+    let input = crate::preview::CpuStageInput { source: &source, info: &info, settings: &region.settings, request: &region.request };
+    let (cache, applied) = h.stages.prepare(side, &signature, options.budget, w.w.max(w.h), original, Some(input));
+    if let Some(cache) = cache {
+        region = region.with_stages(cache);
+    }
+    let rendered = region.run().rendered.map_err(|_| "region_render_failed")?;
+    if rendered.image.width != w.w {
+        return Err("region_render_width_mismatch");
+    }
+    if rendered.image.height != w.h {
+        return Err("region_render_height_mismatch");
+    }
+    h.stages.geometry(side, meta["geometryId"].as_str().ok_or("region_geometry_metadata_mismatch")?);
+    diagnostics["stageCache"] = h.stages.finish(side, options.budget, applied);
+    diagnostics["execution"] = serde_json::to_value(rendered.execution.ok_or("region_render_failed")?).map_err(|_| "region_render_failed")?;
+    diagnostics["workWindow"] = wjson(work);
+    diagnostics["nativeMs"] = json!(started.elapsed().as_secs_f64() * 1000.0);
+    response["width"] = json!(rendered.image.width);
+    response["height"] = json!(rendered.image.height);
+    crate::write_image(std::path::Path::new(p["path"].as_str().ok_or("region_render_failed")?), &rendered.image, 92)
+        .map_err(|_| "region_render_failed")?;
+    Ok(json!({"response":response,"diagnostics":diagnostics}))
+}
