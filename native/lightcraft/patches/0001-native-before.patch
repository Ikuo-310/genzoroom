+    #[test]
+    fn genzoroom_cpu_required_bytes_tiny_budget_unknown_and_overflow_fail_closed() {
+        let src = Arc::new(Rgb32f::from_fn(32, 24, |_, _| [0.2; 3]));
+        let req = RenderRequest::fit(1024, 1024);
+        let required = if gpu::enabled() { gpu::stage_admission_bytes } else { StageCache::cpu_admission_bytes }
+            (&[], None, &src, &SourceInfo::default(), &DevelopSettings::default(), &req).unwrap();
+        let mut pool = StagePool::default();
+        assert!(!cpu_prepare(&mut pool, 0, &src, &req, 1).1);
+        assert!(!cpu_prepare(&mut pool, 0, &src, &req, required - 1).1);
+        assert!(cpu_prepare(&mut pool, 0, &src, &req, required).1);
+        // Missing source/Plan evidence retains the original conservative admission.
+        assert!(!pool.prepare(0, "cpu-geometry", Some(512 << 20), 1024, (3990, 3000), None).1);
+        assert!(!pool.prepare(0, "cpu-geometry", Some(usize::MAX), usize::MAX, (usize::MAX, 2), None).1);
+        let overflow = RenderRequest::fit(usize::MAX, usize::MAX);
+        assert!(StageCache::cpu_admission_bytes(&[], None, &src, &SourceInfo::default(), &DevelopSettings::default(), &overflow).is_none());
+        let mut invalid = (*src).clone();
+        invalid.width = usize::MAX;
+        assert!(!cpu_prepare(&mut pool, 0, &Arc::new(invalid), &req, 512 << 20).1);
+    }
