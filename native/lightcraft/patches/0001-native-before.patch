+    #[test]
+    fn genzoroom_gpu_plan_budget_boundaries_and_both_views() {
+        let src = Arc::new(Rgb32f::from_fn(2560, 1925, |_, _| [0.2; 3]));
+        let req = RenderRequest::fit(1024, 1024);
+        let info = SourceInfo::default(); let s = DevelopSettings::default();
+        let required = gpu::stage_admission_bytes(&[], None, &src, &info, &s, &req).unwrap();
+        assert!(required < 512 << 20);
+        let mut pool = StagePool::default();
+        // The actual allocator path is selected by preference; both have finite bounds.
+        let bound = if gpu::enabled() { required } else {
+            StageCache::cpu_admission_bytes(&[], None, &src, &info, &s, &req).unwrap()
+        };
+        assert!(!cpu_prepare(&mut pool, 0, &src, &req, bound - 1).1);
+        assert!(cpu_prepare(&mut pool, 0, &src, &req, bound).1);
+        assert!(cpu_prepare(&mut pool, 0, &src, &req, bound + 1).1);
+        assert!(!cpu_prepare(&mut pool, 0, &src, &req, 1).1);
+        if !gpu::available() { lightcraft_testkit::skip!(Gpu, "two-view fixture requires GPU"); return; }
+        for side in 0..2 {
+            for edge in [32, 64, 32] {
+                let req = RenderRequest::fit(edge, edge);
+                let cache = cpu_prepare(&mut pool, side, &src, &req, 512 << 20).0.unwrap();
+                let result = gpu::render(&src, &info, &s, &req, Some(&cache)).unwrap();
+                assert_eq!(result.execution.unwrap().outcome, "gpu_success");
+                assert!(cache.peek_extension::<gpu::GpuStages>().unwrap().len() <= 2);
+            }
+        }
+        assert!(pool.finish(0, Some(512 << 20), true)["retainedBytes"].as_u64().unwrap() <= 512 << 20);
+        pool.geometry(0, "first"); pool.geometry(0, "changed");
+        assert_eq!(gpu::stage_bytes(pool.slots[0].as_ref().unwrap()), 0);
+        pool.prepare(1, "changed-signature", Some(512 << 20), 64, (3990, 3000), None);
+        assert_eq!(gpu::stage_bytes(pool.slots[1].as_ref().unwrap()), 0);
+        pool.source("changed-source"); assert!(pool.slots.iter().all(Option::is_none));
+    }
