+#[cfg(test)]
+mod tests {
+    use super::*;
+    use lightcraft_engine::{
+        develop::DevelopSettings,
+        pipeline::{self, RenderRequest, SourceInfo},
+    };
+    use lightcraft_raster::Rgb32f;
+
+    #[test]
+    fn genzoroom_rejects_malformed_options_before_rendering() {
+        for value in [Value::Null, json!(true), json!(1), json!("DRAFT"), json!("fast")] {
+            assert!(matches!(Options::parse(&json!({"quality":value})), Err("preview_invalid_quality")));
+        }
+        for value in [Value::Null, json!(true), json!(1.0), json!(2), json!(-1)] {
+            assert!(matches!(Options::parse(&json!({"preview_contract":value})), Err("preview_invalid_contract")));
+        }
+        for value in [Value::Null, json!(true), json!(0), json!("reuse")] {
+            assert!(matches!(Options::parse(&json!({"stage_cache":value})), Err("preview_invalid_stage_cache")));
+        }
+        for value in [Value::Null, json!(true), json!(0), json!(-1), json!(1.0), json!(u64::MAX)] {
+            assert!(matches!(Options::parse(&json!({"stage_cache":"on","stage_cache_budget_bytes":value})), Err("preview_invalid_stage_cache")));
+        }
+        assert!(Options::parse(&json!({"stage_cache":"on"})).is_err());
+        assert!(Options::parse(&json!({"stage_cache":"off","stage_cache_budget_bytes":1})).is_err());
+        assert!(!Options::parse(&json!({})).unwrap().adaptive);
+        let full = Options::parse(&json!({"preview_contract":1})).unwrap();
+        assert!(full.adaptive && !full.draft && full.budget.is_none());
+        assert!(!error("upstream path or secrets").content[0]["text"].as_str().unwrap().contains("upstream"));
+    }
+
+    #[test]
+    fn genzoroom_geometry_tracks_coordinates_not_tone_quality_or_size() {
+        let src = Rgb32f::from_fn(96, 64, |x, y| [0.03 + (x + y) as f32 / 600.0; 3]);
+        let mut s = DevelopSettings::default();
+        let info = SourceInfo::default();
+        let render_meta = |s: &DevelopSettings, edge, draft| {
+            let mut req = RenderRequest::fit(edge, edge);
+            if draft {
+                req.quality = pipeline::Quality::Draft;
+            }
+            let r = pipeline::render(&src, &info, s, &req);
+            frame_metadata(r.frame.as_ref().unwrap(), (6001, 4001), "source-one", r.image.width, r.image.height).unwrap()
+        };
+        let full = render_meta(&s, 32, false);
+        assert_eq!(full["nativeWidth"], 6001);
+        assert_eq!(full["nativeHeight"], 4001);
+        s.light.exposure = 1.0;
+        s.optics.vignetting = 20.0;
+        assert_eq!(full["geometryId"], render_meta(&s, 64, true)["geometryId"]);
+        s.crop.flip_h = true;
+        assert_ne!(full["geometryId"], render_meta(&s, 32, false)["geometryId"]);
+        s.crop.flip_h = false;
+        s.optics.distortion = 20.0;
+        assert_ne!(full["geometryId"], render_meta(&s, 32, false)["geometryId"]);
+        let r = pipeline::render(&src, &info, &s, &RenderRequest::fit(32, 32));
+        let frame = r.frame.as_ref().unwrap();
+        let other = frame_metadata(frame, (6001, 4001), "source-two", r.image.width, r.image.height).unwrap();
+        assert_ne!(other["geometryId"], render_meta(&s, 32, false)["geometryId"]);
+        let mut invalid = frame.clone();
+        invalid.crop.angle = f64::NAN;
+        assert!(matches!(frame_metadata(&invalid, (6001, 4001), "source-two", r.image.width, r.image.height), Err("preview_geometry_mismatch")));
+    }
+
+    #[test]
+    fn genzoroom_stage_pool_reuses_separates_and_enforces_the_total_budget() {
+        let mut pool = StagePool::default();
+        pool.source("source-one");
+        let limit = memory::budget();
+        let (after, applied) = pool.prepare(0, "geometry-one", Some(limit), 32, (32, 32));
+        assert!(applied);
+        let after = after.unwrap();
+        let src = Arc::new(Rgb32f::from_fn(32, 32, |x, y| [0.03 + (x + y) as f32 / 500.0; 3]));
+        let req = RenderRequest::fit(32, 32);
+        let mut s = DevelopSettings::default();
+        let first = pipeline::render_cached(&src, &SourceInfo::default(), &s, &req, &after);
+        assert_eq!(after.len(), 1);
+        let (same, _) = pool.prepare(0, "geometry-one", Some(limit), 32, (32, 32));
+        assert!(Arc::ptr_eq(&after, &same.unwrap()));
+        let (before, _) = pool.prepare(1, "before-import", Some(limit), 32, (32, 32));
+        assert!(!Arc::ptr_eq(&after, &before.unwrap()));
+        let mut draft = req;
+        draft.quality = pipeline::Quality::Draft;
+        s.detail.nr_luminance = 30.0;
+        let _ = pipeline::render_cached(&src, &SourceInfo::default(), &s, &draft, &after);
+        let final_full = pipeline::render_cached(&src, &SourceInfo::default(), &s, &req, &after);
+        let uncached = pipeline::render(&src, &SourceInfo::default(), &s, &req);
+        assert_eq!(final_full.image.data, uncached.image.data);
+        assert_ne!(first.image.data.len(), 0);
+        drop(after);
+        let retained = pool.finish(0, Some(limit), true);
+        assert!(retained["retainedBytes"].as_u64().unwrap() > 0);
+        assert!(retained["retainedBytes"].as_u64().unwrap() <= limit as u64);
+        // Exercise post-render eviction independently of the conservative admission estimate.
+        assert_eq!(pool.finish(0, Some(1), true)["retainedBytes"], 0);
+        assert!(pool.slots.iter().all(Option::is_none));
+        // Lowering the configured limit clears both sides before any new cache admission.
+        let (none, applied) = pool.prepare(0, "geometry-one", Some(1), 32, (32, 32));
+        assert!(none.is_none() && !applied);
+        assert_eq!(pool.finish(0, Some(1), false)["retainedBytes"], 0);
+        let _ = pool.prepare(0, "geometry-one", Some(limit), 32, (32, 32));
+        pool.source("source-two");
+        assert!(pool.slots.iter().all(Option::is_none));
+        let _ = pool.prepare(0, "geometry-one", None, 32, (32, 32));
+        assert_eq!(pool.finish(0, None, false)["retainedBytes"], 0);
+    }
+}
