+#[test]
+fn crop_edit_returns_uncropped_frame_without_changing_settings() {
+    let mut h = Headless::demo();
+    let id = h.session.active().unwrap().0;
+    h.session.execute("crop.set", &json!({"rect": [0.2, 0.2, 0.8, 0.8]})).unwrap();
+    let before = h.session.execute("develop.get", &json!({"id": id})).unwrap();
+    let whole = call_tool(&mut h, "render_preview", &json!({"id": id, "max_side": 64, "include_frame": true}));
+    assert!(!whole.is_error, "{whole:?}");
+    let whole_meta: Value = serde_json::from_str(whole.content[1]["text"].as_str().unwrap()).unwrap();
+    let edit = call_tool(&mut h, "render_preview", &json!({"id": id, "max_side": 64, "include_frame": true, "crop_edit": true}));
+    assert!(!edit.is_error, "{edit:?}");
+    let meta: Value = serde_json::from_str(edit.content[1]["text"].as_str().unwrap()).unwrap();
+    assert_eq!(meta["cropEdit"], true);
+    assert_ne!(meta["frame"]["geometryId"], whole_meta["frame"]["geometryId"]);
+    assert_eq!(meta["frame"]["fullWidth"], meta["width"]);
+    assert_eq!(meta["frame"]["fullHeight"], meta["height"]);
+    assert_eq!(h.session.execute("develop.get", &json!({"id": id})).unwrap(), before);
+}
