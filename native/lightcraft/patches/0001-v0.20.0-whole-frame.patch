+    assert_eq!(after_meta["frame"]["window"], Value::Null);
+    assert_ne!(before.image().unwrap().0, after.image().unwrap().0);
+
+    for (is_before, quality) in [(true, "full"), (false, "draft")] {
+        let result = call_tool(&mut h, "render_preview", &json!({"id":id,"max_side":64,"before":is_before,"quality":quality}));
+        assert!(!result.is_error, "{result:?}");
+        let meta: Value = serde_json::from_str(result.content[1]["text"].as_str().unwrap()).unwrap();
+        assert_eq!(meta["kind"], if is_before { "before" } else { "after" });
+        assert_eq!(meta["quality"], quality);
+        assert!(valid_sdr_histogram(&meta["histogram"]));
+    }
+}
+
+fn valid_sdr_histogram(histogram: &Value) -> bool {
+    ["r", "g", "b", "luma"].into_iter().all(|channel| {
+        histogram[channel].as_array().is_some_and(|bins| {
+            bins.len() == 256 && bins.iter().all(Value::is_u64)
+        })
+    }) && histogram["samples"].as_u64().is_some_and(|samples| samples > 0)
+}
