 }
+
+#[test]
+fn whole_frame_metadata_matches_png_and_legacy_render() {
+    let mut h = Headless::demo();
+    let id = h.session.active().unwrap().0;
+    let legacy = call_tool(&mut h, "render_photo", &json!({"id": id, "size": 64}));
+    assert!(!legacy.is_error, "{legacy:?}");
+    let legacy_meta: Value = serde_json::from_str(legacy.content[1]["text"].as_str().unwrap()).unwrap();
+    assert!(legacy_meta.get("frame").is_none());
+    let result = call_tool(&mut h, "render_photo", &json!({"id": id, "size": 64, "include_frame": true}));
+    assert!(!result.is_error, "{result:?}");
+    let meta: Value = serde_json::from_str(result.content[1]["text"].as_str().unwrap()).unwrap();
+    let (encoded, mime) = result.image().unwrap();
+    assert_eq!(mime, "image/png");
+    let bytes = crate::base64::base64_decode(encoded).unwrap();
+    assert_eq!(&bytes[..8], b"\x89PNG\r\n\x1a\n");
+    let width = u32::from_be_bytes(bytes[16..20].try_into().unwrap());
+    let height = u32::from_be_bytes(bytes[20..24].try_into().unwrap());
+    assert_eq!(meta["width"], width);
+    assert_eq!(meta["height"], height);
+    assert_eq!(meta["frame"]["fullWidth"], width);
+    assert_eq!(meta["frame"]["fullHeight"], height);
+    assert_eq!(meta["frame"]["window"], Value::Null);
+    assert_eq!(meta["frame"]["geometryId"].as_str().unwrap().len(), 64);
+    let preview = call_tool(&mut h, "render_preview", &json!({"id": id, "max_side": 64, "include_frame": true}));
+    assert!(!preview.is_error, "{preview:?}");
+    let preview_meta: Value = serde_json::from_str(preview.content[1]["text"].as_str().unwrap()).unwrap();
+    assert_eq!(preview_meta["frame"]["geometryId"], meta["frame"]["geometryId"]);
+}
