+        .unwrap();
+    assert_eq!(a_again["status"], "ok");
+    assert_ne!(a_again["importedIds"][0].as_u64().unwrap(), a, "retired path metadata cannot shadow a fresh PhotoId");
+    let _ = std::fs::remove_dir_all(&base);
