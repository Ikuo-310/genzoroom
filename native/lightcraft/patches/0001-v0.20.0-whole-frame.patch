+fn wb_candidate(s: &mut Session, id: PhotoId, point: Option<(f64, f64)>) -> std::result::Result<(f64, f64), String> {
+    let info = s.source_info(id);
+    let src = s.source_now(id, SourceLevel::Thumb).map_err(|e| e.to_string())?;
+    let (temp, tint) = if let Some((x, y)) = point {
+        if !x.is_finite() || !y.is_finite() || !(0.0..=1.0).contains(&x) || !(0.0..=1.0).contains(&y) {
+            return Err("invalid white balance point".into());
+        }
+        let settings = s.develop_of(id).unwrap_or_default();
+        // The picker samples the oriented source; the caller maps displayed coordinates into this space.
+        let oriented = src.oriented(settings.orientation);
+        let (cx, cy) = ((x * oriented.width as f64) as isize, (y * oriented.height as f64) as isize);
+        let mut average = [0.0f32; 3];
+        for dy in -2..=2 {
+            for dx in -2..=2 {
+                let color = oriented.get_clamped(cx + dx, cy + dy);
+                for channel in 0..3 {
+                    average[channel] += color[channel] / 25.0;
+                }
+            }
+        }
+        let patch = lightcraft_raster::Rgb32f::filled(4, 4, average);
+        lightcraft_pipeline::auto::auto_wb(&patch, &info)
+    } else {
+        lightcraft_pipeline::auto::auto_wb(&src, &info)
+    };
+    Ok((temp, tint))
+}
