+#[test]
+fn point_color_range_preview_is_explicit_and_read_only() {
+    let mut h = Headless::demo();
+    let id = h.session.active().unwrap().0;
+    let settings = json!({"point_colors":[
+        {"lum":0.5,"chroma":0.1,"hue":30.0},
+        {"lum":0.6,"chroma":0.12,"hue":210.0}
+    ]});
+    h.session.execute("develop.merge", &json!({"settings":settings})).unwrap();
+    let before = h.session.execute("develop.get", &json!({"id":id})).unwrap();
+    let geometry_id = serde_json::from_str::<Value>(call_tool(&mut h, "render_preview",
+        &json!({"id":id,"max_side":64,"include_frame":true})).content[1]["text"].as_str().unwrap()).unwrap()
+        ["frame"]["geometryId"].clone();
+    for (quality, index) in [("draft", 0), ("full", 1)] {
+        let result = call_tool(&mut h, "render_preview", &json!({"id":id,"max_side":64,"include_frame":true,
+            "quality":quality,"point_color_range_index":index}));
+        assert!(!result.is_error, "{result:?}");
+        let meta: Value = serde_json::from_str(result.content[1]["text"].as_str().unwrap()).unwrap();
+        assert_eq!(meta["pointColorRangeIndex"], index);
+        assert_eq!(meta["quality"], quality);
+        assert_eq!(meta["frame"]["window"], Value::Null);
+        assert_eq!(result.image().unwrap().1, "image/png");
+        if quality == "full" { assert_eq!(meta["frame"]["geometryId"], geometry_id); }
+    }
+    let normal = call_tool(&mut h, "render_preview", &json!({"id":id,"max_side":64,"include_frame":true}));
+    assert!(!normal.is_error, "{normal:?}");
+    let normal_meta: Value = serde_json::from_str(normal.content[1]["text"].as_str().unwrap()).unwrap();
+    assert!(normal_meta.get("pointColorRangeIndex").is_none());
+    assert_eq!(normal_meta["frame"]["geometryId"], geometry_id);
+    assert!(call_tool(&mut h,"render_preview",&json!({"id":id,"max_side":64,"before":true,"point_color_range_index":0})).is_error);
+    assert!(call_tool(&mut h,"render_preview",&json!({"id":id,"max_side":64,"crop_edit":true,"point_color_range_index":0})).is_error);
+    assert!(call_tool(&mut h,"render_preview",&json!({"id":id,"max_side":64,"point_color_range_index":2})).is_error);
+    assert!(call_tool(&mut h,"render_preview",&json!({"id":id,"max_side":64,"point_color_range_index":1.5})).is_error);
+    assert_eq!(before, h.session.execute("develop.get", &json!({"id":id})).unwrap());
+}
