+//! Geometry of the rendered Whole image.
+use lightcraft_engine::pipeline::geometry::Frame;
+use serde_json::{Value, json};
+use sha2::{Digest, Sha256};
+
+const GEOMETRY_DESCRIPTOR_CONTRACT: u64 = 2;
+const GEOMETRY_SUBPIXELS_PER_PIXEL: f64 = 256.0;
+
+fn canonical_crop(frame: &Frame, original: (usize, usize)) -> (Value, f64) {
+    let (grid_w, grid_h) = if frame.orient.swaps_axes() { (original.1, original.0) } else { original };
+    let scale_x = grid_w as f64 * GEOMETRY_SUBPIXELS_PER_PIXEL;
+    let scale_y = grid_h as f64 * GEOMETRY_SUBPIXELS_PER_PIXEL;
+    let mut crop = frame.crop;
+    // Frame's constrained crop uses pixel-space tolerances; normalize subpixel solver noise across proxies.
+    let x0 = (crop.rect.x0 * scale_x).round() / scale_x;
+    let x1 = (crop.rect.x1 * scale_x).round() / scale_x;
+    if x0 < x1 {
+        crop.rect.x0 = x0;
+        crop.rect.x1 = x1;
+    }
+    let y0 = (crop.rect.y0 * scale_y).round() / scale_y;
+    let y1 = (crop.rect.y1 * scale_y).round() / scale_y;
+    if y0 < y1 {
+        crop.rect.y0 = y0;
+        crop.rect.y1 = y1;
+    }
+    let native_aspect = (crop.rect.width() * grid_w as f64) / (crop.rect.height() * grid_h as f64);
+    (json!(crop), native_aspect)
+}
+
+pub(crate) fn frame_metadata(frame: &Frame, original: (usize, usize), source: &str, width: usize, height: usize) -> Result<Value, &'static str> {
+    let (native_w, native_h) = frame.native_size_at(original.0, original.1).ok_or("preview_geometry_unavailable")?;
+    let (crop, native_aspect) = canonical_crop(frame, original);
+    let sampling_aspect = frame.aspect();
+    let mut coordinates = vec![frame.ow, frame.oh, frame.crop.angle, frame.crop.rect.x0, frame.crop.rect.y0, frame.crop.rect.x1, frame.crop.rect.y1];
+    if let Some(warp) = &frame.warp {
+        coordinates.extend([warp.w, warp.h, warp.k1, warp.lens_dist]);
+        coordinates.extend(warp.ca);
+        coordinates.extend(warp.persp.0);
+        if let Some(lens) = &warp.lens {
+            if let Some(lens_warp) = &lens.warp {
+                coordinates.extend([lens_warp.center.x, lens_warp.center.y, lens_warp.radius]);
+                coordinates.extend(lens_warp.planes.iter().flatten().copied());
+            }
+            for stage in lens.stages.iter().flatten() {
+                coordinates.extend([stage.center.x, stage.center.y, stage.radius]);
+                coordinates.extend(stage.planes.iter().flatten().copied());
+            }
+        }
+    }
+    if !sampling_aspect.is_finite()
+        || sampling_aspect <= 0.0
+        || !native_aspect.is_finite()
+        || native_aspect <= 0.0
+        || width == 0
+        || height == 0
+        || frame.src_w == 0
+        || frame.src_h == 0
+        || frame.fit(width, height) != (width, height)
+        || coordinates.iter().any(|value| !value.is_finite())
+    {
+        return Err("preview_geometry_mismatch");
+    }
+
+    // Gain-only vignetting does not move coordinates and must not invalidate the geometry identity.
+    let warp = frame.warp.as_ref().filter(|warp| warp.moves_pixels()).map(|warp| {
+        let mut lens = warp.lens;
+        if let Some(lens) = &mut lens {
+            lens.vignette = None;
+        }
+        json!({
+            "perspective": warp.persp,
+            "k1": warp.k1,
+            "ca": warp.ca,
+            "lens": if warp.lens_dist == 0.0 { None } else { lens },
+            "lensDist": warp.lens_dist
+        })
+    });
+    // Sampling dimensions validate this frame; canonical identity uses original-grid geometry.
+    let descriptor = json!({
+        "contract": GEOMETRY_DESCRIPTOR_CONTRACT,
+        "source": source,
+        "original": [original.0, original.1],
+        "nativeAspect": native_aspect,
+        "orientation": frame.orient,
+        "crop": crop,
+        "flip": [frame.flip_h, frame.flip_v],
+        "warp": warp
+    });
+    let bytes = serde_json::to_vec(&descriptor).map_err(|_| "preview_geometry_unavailable")?;
+    let geometry_id = format!("{:x}", Sha256::digest(bytes));
+    Ok(json!({
+        "geometryId": geometry_id,
+        "nativeWidth": native_w.round().max(1.0) as u64,
+        "nativeHeight": native_h.round().max(1.0) as u64,
+        "aspect": sampling_aspect,
+        "fullWidth": width,
+        "fullHeight": height,
+        "window": null
+    }))
+}
