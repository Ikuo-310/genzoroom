+fn headless_import_reuses_canonical_paths_and_keeps_missing_path_fallback() {
+    let current = std::env::current_dir().unwrap();
+    let relative_base = std::path::PathBuf::from(format!(".tmp-fs03-paths-{}", std::process::id()));
+    let base = current.join(&relative_base);
+    let _ = std::fs::remove_dir_all(&base);
+    std::fs::create_dir_all(base.join("nested")).unwrap();
+    for (name, color) in [("A", 80), ("B", 100)] {
+        let image = lightcraft_raster::Rgba8 { width: 12, height: 8, data: vec![[color, 120, 160, 255]; 96] };
+        let png = lightcraft_codecs::encode_png(&lightcraft_codecs::EncodeImage::rgba8(&image), &lightcraft_codecs::EncodeMeta::default()).unwrap();
+        std::fs::write(base.join(format!("{name}.png")), png).unwrap();
+    }
+
+    let mut headless = Headless::new(lightcraft_engine::Session::new().with_fs());
+    let first = headless
+        .call("headless.importWithEviction", json!({"paths": [relative_base.join("A.png").to_string_lossy()]}))
+        .unwrap();
+    let a = first["importedIds"][0].as_u64().unwrap();
+    let alias = base.join("nested/../A.png");
+    let duplicate = headless.call("headless.importWithEviction", json!({"paths": [alias.to_string_lossy()]})).unwrap();
