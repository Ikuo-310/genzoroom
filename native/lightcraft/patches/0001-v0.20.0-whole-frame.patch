+#[test]
+fn region_plan_and_render_use_engine_frame_and_standard_region_jobs() {
+    let mut h = Headless::demo();
+    let id = h.session.active().unwrap().0;
+    let colors = json!({"point_colors":[
+        {"lum":0.5,"chroma":0.1,"hue":30.0},
+        {"lum":0.6,"chroma":0.12,"hue":210.0}
+    ]});
+    h.session.execute("develop.merge", &json!({"settings":colors})).unwrap();
+    let settings_before = h.session.execute("develop.get", &json!({"id":id})).unwrap();
+    let whole = call_tool(&mut h, "render_preview", &json!({"id":id,"max_side":64,"include_frame":true}));
+    assert!(!whole.is_error, "{whole:?}");
+    let whole_meta: Value = serde_json::from_str(whole.content[1]["text"].as_str().unwrap()).unwrap();
+    let args = |operation: &str, target: Value| json!({"id":id.to_string(),"region_contract":1,"operation":operation,"target":target});
+    let plan_target = json!({"kind":"after","quality":"full","geometryId":whole_meta["frame"]["geometryId"],"desiredLongEdge":64});
+    let plan = call_tool(&mut h, "render_region_preview", &args("plan", plan_target.clone()));
+    assert!(!plan.is_error, "{plan:?}");
+    let planned: Value = serde_json::from_str(plan.content[0]["text"].as_str().unwrap()).unwrap();
+    assert_eq!(plan.structured.as_ref().unwrap(), &planned);
+    assert_eq!(planned["geometryId"], whole_meta["frame"]["geometryId"]);
+    assert_eq!(planned["fullWidth"], whole_meta["frame"]["fullWidth"]);
+    let full_w = planned["fullWidth"].as_u64().unwrap();
+    let full_h = planned["fullHeight"].as_u64().unwrap();
+    let (x, y, w, hgt) = (full_w / 4, full_h / 4, (full_w / 2).max(1), (full_h / 2).max(1));
+    let target = json!({"kind":"after","quality":"full","geometryId":planned["geometryId"],
+        "fullWidth":full_w,"fullHeight":full_h,"window":{"x":x,"y":y,"w":w,"h":hgt}});
+    let rendered = call_tool(&mut h, "render_region_preview", &args("render", target.clone()));
+    assert!(!rendered.is_error, "{rendered:?}");
+    let meta: Value = serde_json::from_str(rendered.content[1]["text"].as_str().unwrap()).unwrap();
+    let (encoded, mime) = rendered.image().unwrap();
+    assert_eq!(mime, "image/png");
+    let bytes = crate::base64::base64_decode(encoded).unwrap();
+    assert_eq!(u32::from_be_bytes(bytes[16..20].try_into().unwrap()) as u64, w);
+    assert_eq!(u32::from_be_bytes(bytes[20..24].try_into().unwrap()) as u64, hgt);
+    assert_eq!(meta["kind"], "after");
+    assert_eq!(meta["quality"], "full");
+    assert_eq!(meta["window"]["x"], x);
+    assert_eq!(meta["window"]["y"], y);
+    assert_eq!(meta["window"]["w"], w);
+    assert_eq!(meta["window"]["h"], hgt);
+    let mut overlay_args = args("render", target.clone());
+    overlay_args["point_color_range_index"] = json!(1);
+    let overlay = call_tool(&mut h, "render_region_preview", &overlay_args);
+    assert!(!overlay.is_error, "{overlay:?}");
+    let overlay_meta: Value = serde_json::from_str(overlay.content[1]["text"].as_str().unwrap()).unwrap();
+    assert_eq!(overlay_meta["pointColorRangeIndex"], 1);
+    assert_eq!(overlay_meta["geometryId"], target["geometryId"]);
+    assert_eq!(overlay_meta["window"], target["window"]);
+    let mut plan_overlay = args("plan", plan_target.clone());
+    plan_overlay["point_color_range_index"] = json!(0);
+    assert!(call_tool(&mut h,"render_region_preview",&plan_overlay).is_error);
+    let mut invalid_overlay = args("render", target.clone());
+    invalid_overlay["point_color_range_index"] = json!(7);
+    assert!(call_tool(&mut h,"render_region_preview",&invalid_overlay).is_error);
+    let mut before_overlay = target.clone();
+    before_overlay["kind"] = json!("before");
+    let mut invalid_before = args("render", before_overlay);
+    invalid_before["point_color_range_index"] = json!(0);
+    assert!(call_tool(&mut h,"render_region_preview",&invalid_before).is_error);
+    assert_eq!(settings_before, h.session.execute("develop.get", &json!({"id":id})).unwrap());
+}
