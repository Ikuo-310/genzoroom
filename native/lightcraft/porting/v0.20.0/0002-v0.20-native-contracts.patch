+
+    #[test]
+    fn retained_stages_use_physical_buffer_size_and_dedupe_aliases() {
+        if !crate::available() {
+            lightcraft_testkit::skip!(Gpu, "device-buffer capacity fixture requires a GPU adapter");
+            return;
+        }
+        let gpu = crate::device().expect("available device");
+        gpu.trim(0);
+        drop(gpu.buffer(120));
+        let shared = Arc::new(gpu.buffer(100));
+        assert_eq!(shared.len, 100);
+        assert_eq!(shared.raw().size(), 480, "recycled allocation exceeds its logical length");
+
+        let source = Arc::new(Rgb32f::from_fn(12, 8, |_, _| [0.2; 3]));
+        let info = SourceInfo::default();
+        let settings = DevelopSettings::default();
+        let request = RenderRequest::fit(12, 8);
+        let plan = lightcraft_pipeline::plan(&source, &info, &settings, &request);
+        let stages = GpuStages::default();
+        stages.put(Entry {
+            src: source.clone(),
+            geo: plan.geo,
+            sampled: shared.clone(),
+            lin: Some((plan.lin_key, shared.clone())),
+            colour_noise: None,
+            planes: Planes {
+                key: plan.lin_key,
+                log_l: Some(shared.clone()),
+                sharpen: Some((local::sharpen_key(&plan.settings, 1.0), shared.clone())),
+                chroma: Some((1, shared.clone())),
+                ..Default::default()
+            },
+        });
+        assert_eq!(stages.bytes(), 480, "sample, lin, sharpen and chroma alias one allocation");
+        assert_eq!(stages.host_source_bytes(), source.data.capacity() * std::mem::size_of::<[f32; 3]>());
+    }
+
+    #[test]
+    fn incomplete_gpu_render_does_not_retain_stage_entries() {
+        let _serial = crate::DEVICE_TEST_LOCK.lock().unwrap_or_else(|e| e.into_inner());
+        if !crate::available() {
+            lightcraft_testkit::skip!(Gpu, "failed-stage cache fixture requires a GPU adapter");
+            return;
+        }
+        let source = Arc::new(Rgb32f::from_fn(32, 24, |x, y| [0.05 + (x + y) as f32 / 200.0; 3]));
+        let info = SourceInfo::default();
+        let settings = DevelopSettings::default();
+        let request = RenderRequest::fit(32, 24);
+        let cache = lightcraft_pipeline::StageCache::default();
+        crate::inject_fault(crate::Fault::DropWork);
+        let result = crate::try_render(&source, &info, &settings, &request, Some(&cache));
+        crate::reset_failures();
+
+        assert!(result.is_err(), "the injected incomplete result must fall back");
+        assert_eq!(cache.peek_extension::<GpuStages>().map_or(0, |stages| stages.len()), 0);
+    }
+
+    #[test]
+    fn gpu_admission_reserves_per_view_and_shared_source_upload_capacity() {
+        let source = Arc::new(Rgb32f::from_fn(8, 8, |_, _| [0.2; 3]));
+        let info = SourceInfo::default();
+        let settings = DevelopSettings::default();
+        let request = RenderRequest::fit(8, 8);
+        let plan = lightcraft_pipeline::plan(&source, &info, &settings, &request);
+        let additional = GpuStages::default().additional(&source, &plan).unwrap();
+        assert_eq!(additional, 64 * 15 * 4 * 5 / 4 + 64 * 12 * 5 / 4);
+
+        assert_eq!(shared_source_reservation(1024, RETAIN_SOURCE_BYTES, false), Some(1024));
+        assert_eq!(shared_source_reservation(1024, 100 << 20, false), Some(1024 + (100 << 20) * 5 / 4));
+        assert_eq!(shared_source_reservation(1024, 100 << 20, true), Some(1024), "the current photo upload is reused");
+        assert_eq!(capacity_with_pool_spare(usize::MAX), None);
+    }
+}
