+
+    fn input<'a>(source: &'a Arc<Rgb32f>, info: &'a SourceInfo, settings: &'a DevelopSettings, request: &'a RenderRequest) -> CpuStageInput<'a> {
+        CpuStageInput { source, info, settings, request }
