+#[test]
+fn develop_execution_distinguishes_cpu_request_and_gpu_fallback() {
+    let src = Arc::new(lightcraft_scenes::demo_library()[0].render(64, 48));
+    let info = SourceInfo::default();
+    let settings = DevelopSettings::default();
+    let req = RenderRequest::fit(64, 48);
+    let (cpu, fallback) = develop_reporting(&src, &info, &settings, &req, None, false);
+    assert!(fallback.is_none());
+    assert!(cpu.frame.is_some());
+    let cpu_execution = cpu.execution.unwrap();
+    assert_eq!((cpu_execution.outcome, cpu_execution.backend, cpu_execution.reason), ("cpu_not_tried", "cpu", "cpu_requested"));
+
+    if !lightcraft_gpu::available() {
+        lightcraft_testkit::skip!(Gpu, "no GPU adapter ({})", lightcraft_gpu::unavailable_reason().unwrap_or_default());
+        return;
+    }
+    lightcraft_gpu::inject_fault(lightcraft_gpu::Fault::Limit(1));
+    let (fallback_image, why) = develop_reporting(&src, &info, &settings, &req, None, true);
+    assert!(why.as_deref().is_some_and(|reason| reason.contains("limit")));
+    assert!(fallback_image.frame.is_some(), "fallback geometry comes from the CPU Plan that rendered the result");
+    let execution = fallback_image.execution.unwrap();
+    assert_eq!((execution.outcome, execution.backend, execution.reason), ("cpu_fallback", "cpu", "gpu_failed"));
+    lightcraft_gpu::reset_failures();
+}
