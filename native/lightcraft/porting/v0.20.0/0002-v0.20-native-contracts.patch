+    {
+        let _ = stages;
+        0
+    }
+}
+
+/// Retained CPU and device allocation capacities across views, deduplicated by allocation identity.
+pub fn stage_capacities(caches: &[&StageCache]) -> Option<(usize, usize)> {
+    let mut host = Vec::new();
+    let mut device = Vec::new();
+    for cache in caches {
+        host.extend(cache.host_allocations(true));
+        #[cfg(not(target_arch = "wasm32"))]
+        if let Some(stages) = cache.peek_extension::<GpuStages>() {
+            let (stage_host, stage_device) = stages.allocations();
+            host.extend(stage_host);
+            device.extend(stage_device);
+        }
+    }
+    Some((allocation_bytes(&host)?, allocation_bytes(&device)?))
+}
+
+fn allocation_bytes(allocations: &[(usize, usize)]) -> Option<usize> {
+    let mut seen = Vec::new();
+    allocations.iter().try_fold(0usize, |total, &(identity, bytes)| {
+        if seen.contains(&identity) {
+            Some(total)
+        } else {
+            seen.push(identity);
+            total.checked_add(bytes)
+        }
+    })
+}
+
+/// Cache-owned CPU and device peak reservation. Transient scratch/readback and driver memory have
+/// separate owners and are intentionally outside this StageCache contract.
+pub fn stage_admission_bytes(
+    caches: &[&StageCache],
+    target: Option<&StageCache>,
+    src: &Arc<Rgb32f>,
+    info: &SourceInfo,
+    settings: &DevelopSettings,
+    req: &RenderRequest,
+) -> Option<usize> {
+    #[cfg(not(target_arch = "wasm32"))]
+    {
+        let cpu_required = StageCache::cpu_admission_bytes(caches, target, src, info, settings, req)?;
+        let mut cpu_existing_allocations = Vec::new();
+        let mut held_host_allocations = Vec::new();
+        for cache in caches {
+            let cpu_allocations = cache.host_allocations(true);
+            cpu_existing_allocations.extend(cpu_allocations.iter().copied());
+            held_host_allocations.extend(cpu_allocations);
+            #[cfg(not(target_arch = "wasm32"))]
+            if let Some(stages) = cache.peek_extension::<GpuStages>() {
+                held_host_allocations.extend(stages.allocations().0);
+            }
+        }
+        let src_id = Arc::as_ptr(src) as usize;
+        if held_host_allocations.iter().any(|(identity, _)| *identity == src_id) {
+            cpu_existing_allocations.push((src_id, src.data.capacity().checked_mul(std::mem::size_of::<[f32; 3]>())?));
+        }
+        let cpu_existing = allocation_bytes(&cpu_existing_allocations)?;
+        let cpu_additional = cpu_required.checked_sub(cpu_existing)?;
+        let (host_existing, device_existing) = stage_capacities(caches)?;
+
+        let effective = settings.effective();
+        let rendition = lightcraft_pipeline::settings_for(&effective, req);
+        let plan = lightcraft_pipeline::plan(src, info, &rendition, req);
+        let empty = GpuStages::default();
+        let stages = target.and_then(|cache| cache.peek_extension::<GpuStages>());
+        let gpu_additional = stages.as_deref().unwrap_or(&empty).additional(src, &plan)?;
+        let held = host_existing.checked_add(device_existing)?;
+        let shared_source = render::shared_source_admission(src)?;
+        held.checked_add(cpu_additional)?.checked_add(gpu_additional)?.checked_add(shared_source)
+    }
+    #[cfg(target_arch = "wasm32")]
+    {
+        let _ = (caches, target, src, info, settings, req);
+        None
+    }
+}
