+    /// Retain a source decoded during preview preflight only while it still identifies this photo.
+    /// A cold RAW decode must pass through `accept` once so its decoder WB facts are learned.
+    pub fn accept_preview_source(&mut self, job: &RenderJob, source: super::source::DecodedSource) -> bool {
+        let Some(photo) = self.catalog.photo(job.photo) else { return false };
+        if job.source_key != Some(super::quick::source_identity(photo)) {
+            return false;
+        }
+        let needs_wb = source.info.as_ref().is_some_and(|info| {
+            info.raw
+                && !info.relative_wb
+                && photo.develops_raw()
+                && !photo.relative_wb()
+                && info.as_shot_temp.is_finite()
+                && info.as_shot_tint.is_finite()
+                && photo.as_shot_wb != Some((info.as_shot_temp, info.as_shot_tint))
+        });
+        if needs_wb {
+            return false;
+        }
+        self.media.insert_source(job.photo, job.level, source);
+        true
+    }
