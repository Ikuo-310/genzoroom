+#[test]
+fn cpu_admission_uses_keys_and_rejects_unbounded_requests() {
+    use crate::{StageCache, plan, render_cached};
+    use std::sync::Arc;
+
+    let source = Arc::new(Rgb32f::from_fn(48, 32, |_, _| [0.2; 3]));
+    let info = SourceInfo::default();
+    let req = RenderRequest::fit(48, 32);
+    let cache = StageCache::default();
+    let mut settings = DevelopSettings::default();
+    settings.detail.sharpen_amount = 70.0;
+    let first = plan(&source, &info, &settings, &req);
+    let first_pre_nr = first.pre_nr_key;
+    let first_noise = first.noise_key;
+    let first_lin = first.lin_key;
+    drop(first);
+    let fresh = StageCache::cpu_admission_bytes(&[], None, &source, &info, &settings, &req).unwrap();
+    assert!(fresh > source.data.capacity() * std::mem::size_of::<[f32; 3]>());
+    render_cached(&source, &info, &settings, &req, &cache);
+    let warm = StageCache::cpu_admission_bytes(&[&cache], Some(&cache), &source, &info, &settings, &req).unwrap();
+    assert!(warm >= cache.retained_bytes());
+
+    settings.detail.nr_luminance += 1.0;
+    let nr_changed = plan(&source, &info, &settings, &req);
+    assert_eq!(first_pre_nr, nr_changed.pre_nr_key, "pre-NR stages stay reusable across an NR adjustment");
+    assert_ne!(first_noise, nr_changed.noise_key);
+    assert!(StageCache::cpu_admission_bytes(&[&cache], Some(&cache), &source, &info, &settings, &req).unwrap() > warm);
+    assert_eq!(render_cached(&source, &info, &settings, &req, &cache).image, crate::render(&source, &info, &settings, &req).image);
+
+    settings = DevelopSettings::default();
+    settings.detail.sharpen_radius = 2.0;
+    let sharpen_changed = plan(&source, &info, &settings, &req);
+    assert_eq!(first_lin, sharpen_changed.lin_key, "sharpen only invalidates its plane");
+    let base_sigma = crate::local::sharpen_sigma(crate::local::sharpen_sigma_raw(&DevelopSettings::default(), 48.0, 48.0));
+    let changed_sigma = crate::local::sharpen_sigma(crate::local::sharpen_sigma_raw(&settings, 48.0, 48.0));
+    assert_ne!(
+        crate::local::sharpen_key(&DevelopSettings::default(), base_sigma),
+        crate::local::sharpen_key(&settings, changed_sigma),
+        "the sharpen cache key includes the changed radius"
+    );
+    assert_eq!(render_cached(&source, &info, &settings, &req, &cache).image, crate::render(&source, &info, &settings, &req).image);
+
+    let mut invalid_source = (*source).clone();
+    invalid_source.width = usize::MAX;
+    assert!(StageCache::cpu_admission_bytes(&[], None, &Arc::new(invalid_source), &info, &settings, &req).is_none());
+    let mut windowed = req;
+    windowed.window = Some(crate::PixelWindow { x: 0, y: 0, w: 1, h: 1 });
+    assert!(StageCache::cpu_admission_bytes(&[], None, &source, &info, &settings, &windowed).is_none());
+}
