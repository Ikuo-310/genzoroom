+
+    #[test]
+    fn before_after_caches_share_source_accounting_and_are_evicted_by_budget() {
+        let source = Arc::new(Rgb32f::from_fn(48, 32, |x, y| [0.1 + (x + y) as f32 / 400.0; 3]));
+        let info = SourceInfo::default();
+        let settings = DevelopSettings::default();
+        let request = RenderRequest::fit(48, 32);
+        let mut pool = StagePool::default();
+        pool.source("asset-one");
+
+        let budget = 64 << 20;
+        let (after, accepted) = pool.prepare(1, "after-revision", Some(budget), input(&source, &info, &settings, &request));
+        assert!(accepted);
+        let after = after.unwrap();
+        pipeline::render_cached(&source, &info, &settings, &request, &after);
+        pool.geometry(1, "geometry-a");
+
+        let (before, accepted) = pool.prepare(0, "before-revision", Some(budget), input(&source, &info, &settings, &request));
+        assert!(accepted);
+        let before = before.unwrap();
+        assert!(!Arc::ptr_eq(&after, &before));
+        pipeline::render_cached(&source, &info, &settings, &request, &before);
+        let combined = lightcraft_engine::gpu::stage_capacities(&[&after, &before]).unwrap().0;
+        assert!(combined < after.retained_bytes() + before.retained_bytes(), "the pinned source allocation is shared");
+
+        let evicted = pool.finish(1, Some(1), true);
+        assert_eq!(evicted["retainedBytes"], 0);
+        assert_eq!(evicted["applied"], false);
+        assert!(pool.slots.iter().all(Option::is_none), "finish releases caches that exceed a lowered budget");
+        let (rejected, accepted) = pool.prepare(0, "tiny-budget", Some(1), input(&source, &info, &settings, &request));
+        assert!(rejected.is_none() && !accepted);
+        assert!(pool.slots.iter().all(Option::is_none), "shrinking budget drops retained entries");
+        let report = pool.finish(0, Some(1), false);
+        assert_eq!(report["retainedBytes"], 0);
+
+        let (off, accepted) = pool.prepare(1, "cache-off", None, input(&source, &info, &settings, &request));
+        assert!(off.is_none() && !accepted);
+        assert!(pool.slots.iter().all(Option::is_none));
+    }
+
+    #[test]
+    fn stage_pool_rejects_unknown_sizes_and_discards_failed_or_replaced_entries() {
+        let source = Arc::new(Rgb32f::from_fn(24, 16, |_, _| [0.2; 3]));
+        let info = SourceInfo::default();
+        let settings = DevelopSettings::default();
+        let request = RenderRequest::fit(24, 16);
+        let mut pool = StagePool::default();
+        let budget = 64 << 20;
+        let (cache, accepted) = pool.prepare(0, "one", Some(budget), input(&source, &info, &settings, &request));
+        assert!(accepted);
+        let cache = cache.unwrap();
+        pipeline::render_cached(&source, &info, &settings, &request, &cache);
+        assert!(cache.len() > 0);
+        pool.discard(0);
+        assert!(pool.slots[0].is_none());
+        assert_eq!(pool.finish(0, Some(budget), true)["applied"], false);
+        assert_eq!(pool.finish(0, None, true)["applied"], false);
+
+        let (cache, accepted) = pool.prepare(0, "two", Some(budget), input(&source, &info, &settings, &request));
+        assert!(accepted && cache.is_some());
+        let mut malformed = (*source).clone();
+        malformed.width = usize::MAX;
+        let malformed = Arc::new(malformed);
+        let (rejected, accepted) = pool.prepare(0, "bad", Some(budget), input(&malformed, &info, &settings, &request));
+        assert!(rejected.is_none() && !accepted);
+        assert!(pool.slots[0].is_none(), "unmeasurable admission cannot retain a cache");
+    }
