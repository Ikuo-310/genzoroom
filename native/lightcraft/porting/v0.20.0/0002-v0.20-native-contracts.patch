+#[test]
+fn stage_cache_counts_capacity_aliases_sharpen_and_chroma_once() {
+    use crate::{CacheEntry, StageCache, local};
+    use lightcraft_raster::Plane;
+    use std::sync::Arc;
+
+    let source = Arc::new(Rgb32f { width: 1, height: 1, data: Vec::with_capacity(4) });
+    let sampled = source.clone();
+    let lin = Arc::new(Rgb32f { width: 1, height: 1, data: Vec::with_capacity(5) });
+    let sharpen = Arc::new(Plane { width: 1, height: 1, data: Vec::with_capacity(6) });
+    let chroma = Arc::new(Rgb32f { width: 1, height: 1, data: Vec::with_capacity(7) });
+    let cache = StageCache::default();
+    cache.put(CacheEntry {
+        src: source.clone(),
+        geo: 1,
+        sampled,
+        lin: Some((1, lin)),
+        colour_noise: Some((
+            1,
+            crate::nrc_joint::JointNoise { model: local::NrcNoise { alpha: [0.1; 3], beta: [0.01; 3] }, ymax: [1.0; 3], tolerance: 0.5 },
+        )),
+        planes: local::Planes {
+            key: 1,
+            sharpen: Some(((0, lightcraft_develop::Process::LATEST), sharpen)),
+            chroma: Some((1, chroma)),
+            ..Default::default()
+        },
+    });
+
+    let expected = 4 * std::mem::size_of::<[f32; 3]>()
+        + 5 * std::mem::size_of::<[f32; 3]>()
+        + 6 * std::mem::size_of::<f32>()
+        + 7 * std::mem::size_of::<[f32; 3]>();
+    assert_eq!(cache.retained_bytes(), expected);
+    assert_eq!(cache.bytes(), expected, "an allocation aliased as a stage remains part of stage bytes");
+    assert_eq!(cache.host_allocations(true).iter().filter(|(id, _)| *id == Arc::as_ptr(&source) as usize).count(), 2);
+}
