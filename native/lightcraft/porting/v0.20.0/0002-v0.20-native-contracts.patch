+/// Host source capacities pinned by a view's GPU stages.
+pub fn stage_host_bytes(stages: &StageCache) -> usize {
+    #[cfg(not(target_arch = "wasm32"))]
+    {
+        stages.peek_extension::<GpuStages>().map(|g| g.host_source_bytes()).unwrap_or(0)
+    }
